"""Type stubs for the native extension module (built by the ``krishiv-python`` crate).

The signatures mirror the runtime API of each class and function; the thin
Python layer in ``krishiv.sql`` wraps these handles without changing their
meanings. Checked by ``mypy.stubtest`` (see ``tests/test_stubs.py``; the
command passes ``--ignore-disjoint-bases`` because the pyo3 handles are
layout-disjoint, which user code never observes).
"""

from __future__ import annotations

from typing import final

__version__: str
__allocator__: str
__all__ = [
    "ArrowStream",
    "Column",
    "DataFrame",
    "GroupedData",
    "Session",
    "__allocator__",
    "__version__",
    "call_function",
    "col",
    "count_distinct",
    "count_star",
    "expr",
    "lit",
]

@final
class Session:
    def __new__(cls, config: list[tuple[str, str]] | None = ...) -> Session: ...
    def sql(self, query: str) -> DataFrame: ...
    def table(self, name: str) -> DataFrame: ...
    def read(self, format: str, paths: list[str], options: list[tuple[str, str]] | None = ...) -> DataFrame: ...
    def create_dataframe(self, data: object) -> DataFrame: ...
    def temp_table_names(self) -> list[str]: ...
    def drop_temp_view(self, name: str) -> bool: ...
    @staticmethod
    def is_dataframe_table(name: str) -> bool: ...
    def conf_is_modifiable(self, key: str) -> bool: ...
    def conf_get(self, key: str) -> str | None: ...
    def conf_set(self, key: str, value: str) -> None: ...
    def conf_unset(self, key: str) -> None: ...

@final
class DataFrame:
    def select(self, cols: list[Column]) -> DataFrame: ...
    def select_expr(self, exprs: list[str]) -> DataFrame: ...
    def filter(self, condition: Column) -> DataFrame: ...
    def filter_expr(self, condition: str) -> DataFrame: ...
    def with_column(self, name: str, value: Column) -> DataFrame: ...
    def group_by(self, cols: list[Column]) -> GroupedData: ...
    def agg(self, cols: list[Column]) -> DataFrame: ...
    def join(
        self, other: DataFrame, on: Column | None = ..., using: list[str] | None = ..., how: str = ...
    ) -> DataFrame: ...
    def order_by(self, cols: list[Column]) -> DataFrame: ...
    def limit(self, n: int) -> DataFrame: ...
    def alias(self, alias: str) -> DataFrame: ...
    def col(self, name: str) -> Column: ...
    def execute(self) -> ArrowStream: ...
    def count(self) -> int: ...
    def write(
        self,
        format: str,
        mode: str,
        path: str,
        options: list[tuple[str, str]] | None = ...,
        partition_by: list[str] | None = ...,
    ) -> None: ...
    def explain(self, mode: str, json: bool = ...) -> str: ...
    def create_or_replace_temp_view(self, name: str) -> None: ...
    def schema(self) -> list[tuple[str, str, bool]]: ...
    def offset(self, n: int) -> DataFrame: ...
    def distinct(self) -> DataFrame: ...
    def union(self, other: DataFrame) -> DataFrame: ...
    def union_by_name(self, other: DataFrame, allow_missing_columns: bool) -> DataFrame: ...
    def intersect(self, other: DataFrame) -> DataFrame: ...
    def intersect_all(self, other: DataFrame) -> DataFrame: ...
    def except_all(self, other: DataFrame) -> DataFrame: ...
    def subtract(self, other: DataFrame) -> DataFrame: ...
    def hint(self, name: str, params: list[Column]) -> DataFrame: ...
    def to_df(self, names: list[str]) -> DataFrame: ...
    def sample(self, with_replacement: bool, fraction: float, seed: int) -> DataFrame: ...
    def unpivot(self, ids: list[Column], values: list[tuple[str, Column]], variable: str, value: str) -> DataFrame: ...

@final
class GroupedData:
    def agg(self, cols: list[Column]) -> DataFrame: ...

@final
class Column:
    def alias(self, name: str) -> Column: ...
    def cast(self, to: str) -> Column: ...
    def try_cast(self, to: str) -> Column: ...
    def add(self, other: Column) -> Column: ...
    def sub(self, other: Column) -> Column: ...
    def mul(self, other: Column) -> Column: ...
    def div(self, other: Column) -> Column: ...
    def rem(self, other: Column) -> Column: ...
    def neg(self) -> Column: ...
    def invert(self) -> Column: ...
    def eq(self, other: Column) -> Column: ...
    def ne(self, other: Column) -> Column: ...
    def lt(self, other: Column) -> Column: ...
    def le(self, other: Column) -> Column: ...
    def gt(self, other: Column) -> Column: ...
    def ge(self, other: Column) -> Column: ...
    def eq_null_safe(self, other: Column) -> Column: ...
    def and_(self, other: Column) -> Column: ...
    def or_(self, other: Column) -> Column: ...
    def is_null(self) -> Column: ...
    def is_not_null(self) -> Column: ...
    def like(self, pattern: str) -> Column: ...
    def isin(self, values: list[Column]) -> Column: ...
    def between(self, low: Column, high: Column) -> Column: ...
    def sort_order(self, ascending: bool, nulls_first: bool) -> Column: ...

@final
class ArrowStream:
    @staticmethod
    def from_arrow(data: object) -> ArrowStream: ...
    def __arrow_c_schema__(self) -> object: ...
    def __arrow_c_stream__(self, requested_schema: object | None = ...) -> object: ...
    def check_error(self) -> None: ...
    @property
    def consumed(self) -> bool: ...

def col(name: str) -> Column: ...
def lit(value: object) -> Column: ...
def map_literal(pairs: list[tuple[str, str]]) -> Column: ...
def expr(text: str) -> Column: ...
def call_function(name: str, args: list[Column]) -> Column: ...
def count_star() -> Column: ...
def count_distinct(cols: list[Column]) -> Column: ...
