{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KrishivAI/krishiv-engine/docs/reference/analyze/krishiv.analyze.v1.schema.json",
  "title": "Krishiv analyze result, krishiv.analyze.v1",
  "description": "What Session::analyze returns as JSON (Analysis::to_json): a statement's class, the securables it needs, its output schema, column lineage and filter columns. Generated by `cargo xtask docs-analyze` from krishiv_plan::analyzer::lineage::schema. Additive within v1: members and enum values may be added, so a reader ignores members it does not know and accepts enum values it does not know; new alternatives of a `oneOf` (such as a new lineage leaf form) may be added too, so a reader skips an element that matches no alternative it knows and does not validate unknown forms strictly; `required` lists the members v1 has had from the start. Not listed among the securables: a managed table's directory, which a run of DROP TABLE, TRUNCATE TABLE or INSERT also checks only when the directory exists, on its resolved path (not deterministic without file-system I/O).",
  "type": "object",
  "required": ["schema_version", "statement_class", "explain", "partial", "securables", "output_schema", "lineage", "filters", "warnings"],
  "properties": {
    "schema_version": {
      "description": "The document version.",
      "const": "krishiv.analyze.v1"
    },
    "statement_class": {
      "description": "The statement's class, as `system.queries.statement_class` shows it.",
      "enum": ["READ", "WRITE", "DDL", "SESSION", "ADMIN"]
    },
    "explain": {
      "description": "How it explains, if it is an EXPLAIN.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": ["PLAN", "ANALYZE"]
        }
      ]
    },
    "partial": {
      "description": "Whether the statement's reads are not fully known (then it is not provably read-only).",
      "type": "boolean"
    },
    "securables": {
      "description": "What the statement needs, in first-use order: reads (with columns), then targets. Not listed: a managed table's directory, which a run of DROP TABLE, TRUNCATE TABLE or INSERT also checks only when it exists, on its resolved path.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "name", "display", "privilege", "columns"],
        "properties": {
          "kind": {
            "description": "The securable's kind.",
            "enum": ["table", "view", "function", "path", "namespace", "system", "secret", "connection"]
          },
          "name": {
            "description": "Its name parts (a path: its redacted text; a secret: its scope).",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "display": {
            "description": "The securable as the 42501 denial text prints it (redacted by `Securable`'s `Display`, ADR 0038).",
            "type": "string"
          },
          "privilege": {
            "description": "The privilege the statement needs on it.",
            "enum": ["SELECT", "MODIFY", "CREATE", "DROP", "MONITOR", "USAGE", "BROWSE", "OPERATE", "MANAGE", "IMPERSONATE"]
          },
          "columns": {
            "description": "The columns its reads reference, sorted (empty for a target).",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "output_schema": {
      "description": "The result columns: a query's analyzed output; a SHOW, DESCRIBE, EXPLAIN, SET or RESET command's result (RESET and SET PATH: none); empty for writes, DDL and other commands.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ordinal", "name", "type", "type_json", "nullable", "declared_type"],
        "properties": {
          "ordinal": {
            "description": "The output position, from 0.",
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "description": "The output column's name.",
            "type": "string"
          },
          "type": {
            "description": "The type's `simpleString`, for people.",
            "type": "string"
          },
          "type_json": {
            "description": "The type's lossless JSON (`DataType.json`: nested nullability, metadata), as a string.",
            "type": "string"
          },
          "nullable": {
            "description": "Whether it may be null.",
            "type": "boolean"
          },
          "declared_type": {
            "description": "The `CHAR(n)`/`VARCHAR(n)` declaration, if any.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          }
        }
      }
    },
    "lineage": {
      "description": "Per output ordinal of a query, its sources and transform; else empty.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ordinal", "output", "sources", "transform"],
        "properties": {
          "ordinal": {
            "description": "The output position, from 0.",
            "type": "integer",
            "minimum": 0
          },
          "output": {
            "description": "The output column's name.",
            "type": "string"
          },
          "sources": {
            "description": "The leaves the value depends on, sorted.",
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["table", "column", "via_view"],
                  "properties": {
                    "table": {
                      "description": "A catalog table's name parts.",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "column": {
                      "description": "The column (a `_metadata` field is dotted).",
                      "type": "string"
                    },
                    "via_view": {
                      "description": "The outermost expanded (temporary or INVOKER) view the leaf was read through, by its name parts.",
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "required": ["path", "column", "via_view"],
                  "properties": {
                    "path": {
                      "description": "Files read by path: the redacted path, as the 42501 denial prints it.",
                      "type": "string"
                    },
                    "column": {
                      "description": "The column (a `_metadata` field is dotted).",
                      "type": "string"
                    },
                    "via_view": {
                      "description": "The outermost expanded (temporary or INVOKER) view the leaf was read through, by its name parts.",
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "required": ["view", "column", "via_view"],
                  "properties": {
                    "view": {
                      "description": "A view that is not expanded (a DEFINER view): its name parts; nothing under it is shown.",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "column": {
                      "description": "The column (a `_metadata` field is dotted).",
                      "type": "string"
                    },
                    "via_view": {
                      "description": "The outermost expanded (temporary or INVOKER) view the leaf was read through, by its name parts.",
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
          "transform": {
            "description": "The strongest step on any path.",
            "enum": ["literal", "identity", "expression", "generated", "window", "aggregate", "opaque", "masked", "view"]
          }
        }
      }
    },
    "filters": {
      "description": "The columns that decide which rows or groups, sorted by kind in the listed order, then by leaf.",
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["kind", "table", "column"],
            "properties": {
              "kind": {
                "description": "Why the column decides which rows or groups.",
                "enum": ["filter", "join", "group_by", "sort", "window", "conditional"]
              },
              "table": {
                "description": "A catalog table's name parts.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "column": {
                "description": "The column (a `_metadata` field is dotted).",
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": ["kind", "path", "column"],
            "properties": {
              "kind": {
                "description": "Why the column decides which rows or groups.",
                "enum": ["filter", "join", "group_by", "sort", "window", "conditional"]
              },
              "path": {
                "description": "Files read by path: the redacted path, as the 42501 denial prints it.",
                "type": "string"
              },
              "column": {
                "description": "The column (a `_metadata` field is dotted).",
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": ["kind", "view", "column"],
            "properties": {
              "kind": {
                "description": "Why the column decides which rows or groups.",
                "enum": ["filter", "join", "group_by", "sort", "window", "conditional"]
              },
              "view": {
                "description": "A view that is not expanded (a DEFINER view): its name parts; nothing under it is shown.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "column": {
                "description": "The column (a `_metadata` field is dotted).",
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "warnings": {
      "description": "Fixed codes, sorted; never text with user data.",
      "type": "array",
      "items": {
        "enum": ["LINEAGE_OPAQUE_UDF", "UNSUPPORTED_READ_SHAPE", "USER_CODE_RAN_AT_ANALYSIS", "VIEW_NOT_EXPANDED"]
      }
    }
  }
}
