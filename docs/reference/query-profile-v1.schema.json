{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KrishivAI/krishiv-engine/docs/reference/query-profile-v1.schema.json",
  "title": "Krishiv query profile, version 1 (experimental: may change before 1.0)",
  "description": "Experimental: may change before 1.0. The document EXPLAIN ANALYZE writes as JSON (QueryProfile::to_json, `krishiv sql --explain-analyze --json`, DataFrame.explainString(analyze=True, json=True)). Times are integer nanoseconds, sizes integer bytes.",
  "type": "object",
  "required": ["format", "version", "detailed", "query", "pipelines", "plan", "operators"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "krishiv.query-profile" },
    "version": { "const": 1 },
    "detailed": {
      "type": "boolean",
      "description": "Whether the costlier detailed metrics (hash-table probe lengths) were collected."
    },
    "query": {
      "type": "object",
      "required": ["wall_time_ns", "workers", "drivers", "batches", "yields", "max_slice_ns", "stalls"],
      "additionalProperties": false,
      "properties": {
        "wall_time_ns": { "$ref": "#/$defs/u64", "description": "Start of execution to its end (the longest over workers)." },
        "workers": { "$ref": "#/$defs/u64" },
        "drivers": { "$ref": "#/$defs/u64" },
        "batches": { "$ref": "#/$defs/u64", "description": "Source batches pushed." },
        "yields": { "$ref": "#/$defs/u64" },
        "max_slice_ns": { "$ref": "#/$defs/u64", "description": "Longest single poll of a driver." },
        "stalls": { "$ref": "#/$defs/u64", "description": "Polls longer than the stall threshold." }
      }
    },
    "pipelines": {
      "type": "array",
      "description": "By ascending id; ids are unique.",
      "items": {
        "type": "object",
        "required": ["id", "drivers", "threads", "started_ns", "ended_ns"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/u32" },
          "drivers": { "$ref": "#/$defs/u64" },
          "threads": { "$ref": "#/$defs/u64", "description": "Distinct threads that polled its drivers, summed over workers." },
          "started_ns": { "$ref": "#/$defs/u64", "description": "First driver start, after the query started." },
          "ended_ns": { "$ref": "#/$defs/u64", "description": "Last driver end, after the query started." }
        }
      }
    },
    "plan": {
      "type": "array",
      "minItems": 1,
      "description": "The physical plan as EXPLAIN prints it, in pre-order: element 0 is the root and every other element is listed in exactly one `children` of an earlier element.",
      "items": {
        "type": "object",
        "required": ["id", "name", "detail", "children"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "oneOf": [{ "$ref": "#/$defs/u32" }, { "type": "null" }],
            "description": "The plan node's pre-order index, which operators name; null for a heading that is not a plan node (Subquery)."
          },
          "name": { "type": "string" },
          "detail": { "type": "string" },
          "children": { "type": "array", "items": { "$ref": "#/$defs/u64" }, "description": "Positions in `plan`, each greater than this element's." }
        }
      }
    },
    "operators": {
      "type": "array",
      "description": "By ascending id; ids are unique.",
      "items": {
        "type": "object",
        "required": ["id", "name", "node", "role", "pipelines", "metrics", "extra"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/u32" },
          "name": { "type": "string" },
          "node": {
            "oneOf": [{ "$ref": "#/$defs/u32" }, { "type": "null" }],
            "description": "The plan node it implements; null for the query's result."
          },
          "role": { "enum": ["source", "operator", "sink"] },
          "pipelines": { "type": "array", "items": { "$ref": "#/$defs/u32" } },
          "metrics": {
            "type": "object",
            "required": [
              "drivers", "rows_in", "batches_in", "rows_out", "batches_out",
              "compute_time_ns", "max_driver_compute_time_ns", "blocked_on_io_ns",
              "max_driver_blocked_on_io_ns", "blocked_on_memory_ns", "blocked_on_sink_ns",
              "morsels", "peak_reserved_bytes", "spills", "spilled_bytes"
            ],
            "additionalProperties": false,
            "properties": {
              "drivers": { "$ref": "#/$defs/u64" },
              "rows_in": { "$ref": "#/$defs/u64" },
              "batches_in": { "$ref": "#/$defs/u64" },
              "rows_out": { "$ref": "#/$defs/u64" },
              "batches_out": { "$ref": "#/$defs/u64" },
              "compute_time_ns": { "$ref": "#/$defs/u64", "description": "Summed over drivers." },
              "max_driver_compute_time_ns": { "$ref": "#/$defs/u64", "description": "The largest one driver's compute time (skew)." },
              "blocked_on_io_ns": { "$ref": "#/$defs/u64", "description": "Summed over drivers." },
              "max_driver_blocked_on_io_ns": { "$ref": "#/$defs/u64" },
              "blocked_on_memory_ns": { "$ref": "#/$defs/u64" },
              "blocked_on_sink_ns": { "$ref": "#/$defs/u64" },
              "morsels": { "$ref": "#/$defs/u64" },
              "peak_reserved_bytes": { "$ref": "#/$defs/u64", "description": "Summed over drivers: an upper bound of the true peak." },
              "spills": { "$ref": "#/$defs/u64" },
              "spilled_bytes": { "$ref": "#/$defs/u64", "description": "Bytes freed by spills." }
            }
          },
          "extra": {
            "type": "array",
            "description": "Operator-specific metrics; names are unique per operator.",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["name", "kind", "value"],
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string" },
                    "kind": { "enum": ["count", "max"] },
                    "value": { "$ref": "#/$defs/u64" }
                  }
                },
                {
                  "type": "object",
                  "required": ["name", "kind", "value"],
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string" },
                    "kind": { "const": "text" },
                    "value": { "type": "string" }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "u64": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
    "u32": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
  }
}
