{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "timezone": "UTC",
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "customManagers": [
    {
      "description": "The client images of the weekly Spark Connect client run",
      "customType": "regex",
      "fileMatch": [
        "^tests/connect-clients/run\\.sh$"
      ],
      "matchStrings": [
        "_image=\"(?<depName>[^:\"]+):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "pip_requirements": {
    "fileMatch": [
      "(^|/)[\\w-]*requirements([-\\w]*)?\\.(txt|pip)$",
      "(^|/)ci-interop-constraints\\.txt$"
    ]
  },
  "packageRules": [
    {
      "description": "Arrow family moves in lockstep (ADR 0028)",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "/^arrow(-.*)?$/",
        "parquet"
      ],
      "groupName": "arrow family"
    },
    {
      "description": "object_store releases with the Arrow crates and is pinned exactly (ADR 0044, design note P3 section 5): one version across engine and platform, never automerged",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "object_store"
      ],
      "groupName": "arrow family",
      "automerge": false
    },
    {
      "description": "tonic and prost share a prost major",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "/^tonic(-.*)?$/",
        "/^prost(-.*)?$/"
      ],
      "groupName": "tonic and prost"
    },
    {
      "description": "OpenTelemetry crates release together",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "/^opentelemetry(-.*)?$/",
        "/^tracing-opentelemetry$/"
      ],
      "groupName": "opentelemetry"
    },
    {
      "description": "Baseline engine versions move only by deliberate decision (bench provenance, Spark golden fixtures)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "apache/spark"
      ],
      "enabled": false
    },
    {
      "description": "pyspark is pinned to the baseline Spark version",
      "matchPackageNames": [
        "pyspark"
      ],
      "enabled": false
    },
    {
      "description": "GitHub Actions pins: one weekly PR for all action updates (owner 2026-11-15)",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "schedule": [
        "before 6am on monday"
      ]
    }
  ]
}
