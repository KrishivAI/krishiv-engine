#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# Installs Krishiv into ./venv. KRISHIV_VERSION (default 0.2.0) picks the PyPI release; KRISHIV_WHEEL (a path or URL)
# installs that wheel instead. Python 3.11 or newer is required (the wheel is abi3-py311).
set -euo pipefail
cd "$(dirname "$0")"
PATH="$PATH:$HOME/.local/bin:$HOME/.cargo/bin"   # uv's default install places, absent from non-login shells
if command -v uv >/dev/null 2>&1; then
    [ -x venv/bin/python ] || { rm -rf venv; uv venv -q --python 3.12 venv; }
    PIP="uv pip install -q --python venv/bin/python"
else
    # `python3 -m venv` without the python3-venv package leaves a venv with no pip: start over in that case.
    if ! venv/bin/python -m pip --version >/dev/null 2>&1; then
        rm -rf venv
        if ! python3 -m venv venv; then
            rm -rf venv
            sudo apt-get update -y && sudo apt-get install -y python3-venv python3-pip
            python3 -m venv venv
        fi
    fi
    PIP="venv/bin/python -m pip install -q"
fi
$PIP "${KRISHIV_WHEEL:-krishiv==${KRISHIV_VERSION:-0.2.0}}" pyarrow
venv/bin/python -c "import krishiv, pyarrow; print('krishiv ready')"
# queries.sql is generated, not committed (README "Licence"); here so that it stays out of the timed load.
[ -f queries.sql ] || ./make-queries.py > queries.sql
