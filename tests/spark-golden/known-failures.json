{
  "categories": {
    "analyzer-bugs": {
      "kind": "bug",
      "owner": "analyzer follow-up of P2-T071a",
      "summary": "analyzer resolution differs from Spark: an unused CTE definition over a missing relation is not analyzed, so TABLE_OR_VIEW_NOT_FOUND is not raised (cte#16, cte#24), GROUP BY a backquoted output alias `1`, LIMIT over a column reports UNRESOLVED_COLUMN instead of IS_UNFOLDABLE"
    },
    "cast-matrix": {
      "kind": "unsupported",
      "summary": "the full cast matrix: casts not in P2a, cast-named functions, region time zones",
      "task": "P2-T021b"
    },
    "coercion": {
      "kind": "unsupported",
      "summary": "full Spark type coercion (implicit string casts with ANSI off)",
      "task": "P2-T071d"
    },
    "datetime": {
      "kind": "unsupported",
      "summary": "datetime functions and literals beyond P2a (TIMESTAMP literals, date/timestamp arithmetic, patterns, unit-argument forms)",
      "task": "P2-T025"
    },
    "depends-on-command": {
      "kind": "unsupported",
      "summary": "queries that read a table, view, function or variable an earlier command of the file creates (the command failed, so the query fails or reads the shared fixture of the same name)",
      "task": "P2-T179"
    },
    "files": {
      "kind": "unsupported",
      "summary": "partitioned and glob reads of directories",
      "task": "P2-T082b"
    },
    "fn-aggregate": {
      "kind": "unsupported",
      "summary": "aggregate and sketch functions beyond P2a, WITHIN GROUP",
      "task": "P2-T032"
    },
    "fn-array": {
      "kind": "unsupported",
      "summary": "array and collection functions",
      "task": "P2-T028"
    },
    "fn-json": {
      "kind": "unsupported",
      "summary": "JSON functions",
      "task": "P2-T031"
    },
    "fn-map": {
      "kind": "unsupported",
      "summary": "map functions",
      "task": "P2-T029"
    },
    "fn-misc": {
      "kind": "unsupported",
      "summary": "misc functions (typeof, uuid, rand, raise_error, vector, current_*)",
      "task": "P2-T035"
    },
    "fn-regex": {
      "kind": "unsupported",
      "summary": "regular-expression functions and operators",
      "task": "P2-T024"
    },
    "fn-string": {
      "kind": "unsupported",
      "summary": "string and math-tail functions not in P2a (hex, conv, bin, width_bucket, ...)",
      "task": "P2-T023"
    },
    "fn-url-xml-csv": {
      "kind": "unsupported",
      "summary": "URL, XML, CSV and protobuf functions",
      "task": "P2-T038"
    },
    "generators": {
      "kind": "unsupported",
      "summary": "generators: explode, LATERAL VIEW, multi-name aliases, stack, inline",
      "task": "P2-T034"
    },
    "grouping-sets": {
      "kind": "unsupported",
      "summary": "ROLLUP, CUBE, GROUPING SETS, grouping()/grouping_id()",
      "task": "P2-T053b"
    },
    "hof": {
      "kind": "unsupported",
      "summary": "lambda functions and higher-order functions",
      "task": "P2-T036"
    },
    "legacy-configs": {
      "kind": "bug",
      "owner": "config map follow-up of P2-T004",
      "summary": "legacy behaviour flags the session ignores instead of rejecting (ctePrecedencePolicy, consecutiveStringLiterals, allowStarWithSingleTableIdentifierInCount, allowParameterlessCount)"
    },
    "legacy-time-parser": {
      "kind": "unsupported",
      "summary": "the SimpleDateFormat legacy time parser (spark.sql.legacy.timeParserPolicy=LEGACY)",
      "task": "P2-T025"
    },
    "nested-interval-types": {
      "kind": "unsupported",
      "summary": "nested types, intervals, CHAR/VARCHAR, struct constructors, subscripts and field access",
      "task": "P2-T001b"
    },
    "object-stores": {
      "kind": "unsupported",
      "summary": "remote paths (https and object stores)",
      "task": "P2-T084"
    },
    "output-names": {
      "kind": "bug",
      "owner": "analyzer output-name follow-up of P2-T071a",
      "summary": "auto-generated column names differ from Spark's toPrettySQL (Java float/decimal text, default arguments, TRIM/CEIL/LOG/mod spellings, +year dates)"
    },
    "parser-pipe-collate": {
      "kind": "unsupported",
      "summary": "pipe syntax |> and COLLATE / collations",
      "task": "P2-T075b"
    },
    "parser-tail": {
      "kind": "unsupported",
      "summary": "TRANSFORM, IDENTIFIER(), TABLE(...) arguments, TABLESAMPLE, NEAREST BY, variant paths",
      "task": "P2-T075c"
    },
    "query-features": {
      "kind": "unsupported",
      "summary": "query features the analyzer or planner lacks: inline VALUES, table-valued functions, NATURAL and USING joins, recursive CTEs, LATERAL, PIVOT/UNPIVOT, OFFSET, GROUP BY ALL, SELECT * EXCEPT, QUALIFY, named and qualified function names, LIKE ANY/ALL, aggregate FILTER, multi-SELECT FROM",
      "task": "P2-T180"
    },
    "sql-commands": {
      "kind": "unsupported",
      "summary": "SQL commands (DDL, DML, SET/RESET, DESCRIBE/SHOW, session variables, EXECUTE IMMEDIATE, SQL functions): not parsed or executed by the session yet",
      "task": "P2-T179"
    },
    "subqueries": {
      "kind": "unsupported",
      "summary": "general subquery unnesting (correlated shapes beyond TPC-H)",
      "task": "P2-T115"
    },
    "test-udfs": {
      "kind": "unsupported",
      "summary": "the suite's Python/Scala test UDFs (udf/, udaf/, udtf/ folders)",
      "task": "P2-T059"
    },
    "time-geo-types": {
      "kind": "unsupported",
      "summary": "Spark 4.x TIME type and literals; GEOMETRY/GEOGRAPHY types and ST functions",
      "task": "P2-T181"
    },
    "variant-type": {
      "kind": "unsupported",
      "summary": "the VARIANT type",
      "task": "P2-T001c"
    },
    "window": {
      "kind": "unsupported",
      "summary": "window functions and WINDOW clauses",
      "task": "P2-T055"
    }
  },
  "format_version": 1,
  "frozen_at": "2026-10-22",
  "rules": [
    {
      "category": "sql-commands",
      "command": true
    },
    {
      "category": "legacy-configs",
      "file": "^cte-(legacy|nonlegacy)$"
    },
    {
      "category": "legacy-time-parser",
      "file": "^datetime-(parsing|formatting)-legacy$|^datetime-legacy$"
    },
    {
      "category": "legacy-configs",
      "detail": "^rows differ",
      "file": "literals$",
      "query": "\\\"S\\\"\\\"par|'S''par"
    },
    {
      "category": "legacy-configs",
      "detail": "^no error|WRONG_NUM_ARGS",
      "file": "^count$"
    },
    {
      "category": "depends-on-command",
      "depends": true
    },
    {
      "category": "test-udfs",
      "file": "^(udf|udaf|udtf)/"
    },
    {
      "category": "test-udfs",
      "detail": "Cannot resolve routine `(udf|udaf|vol|booleq|boolne)`"
    },
    {
      "category": "sql-commands",
      "query": "(?i)^\\s*explain\\s+(extended\\s+|formatted\\s+)?(desc|describe|show|create|insert|set)\\b"
    },
    {
      "category": "depends-on-command",
      "detail": "TABLE_OR_VIEW_NOT_FOUND.*`(tab_renamed)`"
    },
    {
      "category": "time-geo-types",
      "file": "^st-functions$"
    },
    {
      "category": "parser-tail",
      "file": "^transform$"
    },
    {
      "category": "analyzer-bugs",
      "detail": "AMBIGUOUS_REFERENCE",
      "file": "^cte$"
    },
    {
      "category": "analyzer-bugs",
      "detail": "UNRESOLVED_COLUMN.*`1`",
      "file": "^group-by-alias$"
    },
    {
      "category": "analyzer-bugs",
      "detail": "UNRESOLVED_COLUMN.*`key`",
      "file": "^limit$"
    },
    {
      "category": "datetime",
      "detail": "WRONG_NUM_ARGS.*`(date_add|dateadd|datediff|date_diff)`|Cannot resolve routine `(timestampadd|timestampdiff|timediff)`"
    },
    {
      "category": "datetime",
      "detail": "INVALID_TYPED_LITERAL",
      "file": "^postgreSQL/date$"
    },
    {
      "category": "subqueries",
      "detail": "list-query|UNRESOLVED_COLUMN.*`a`\\.`four`"
    },
    {
      "category": "parser-pipe-collate",
      "query": "(?i)\\|>|\\bcollat(e|ion)\\b|\\|\\s*(select|where|aggregate|extend|set|drop|as|join|union|order|limit|pivot)\\b"
    },
    {
      "category": "parser-pipe-collate",
      "file": "^(pipe-operators|collations)"
    },
    {
      "category": "parser-tail",
      "detail": "^parse failed",
      "query": "(?i)\\b(transform|identifier|tablesample|nearest)\\b|\\btable\\s*\\(|:\\w"
    },
    {
      "category": "fn-string",
      "detail": "The feature the operator ilike"
    },
    {
      "category": "fn-regex",
      "detail": "The feature the operator rlike"
    },
    {
      "category": "query-features",
      "detail": "The feature (VALUES|table-valued functions|NATURAL JOIN|recursive CTEs|LATERAL subqueries|LATERAL joins|PIVOT and UNPIVOT|OFFSET|SELECT \\* EXCEPT|qualified function names|named function arguments|LIKE ANY|FROM with several SELECT|QUALIFY|aggregate FILTER|DISTINCT aggregates over different|JOIN \\.\\.\\. USING)"
    },
    {
      "category": "query-features",
      "detail": "UNRESOLVED_COLUMN.*`ALL`"
    },
    {
      "category": "nested-interval-types",
      "detail": "The feature (INTERVAL literals|interval data types|nested data types|row and struct constructors|subscripts|field access|char/varchar)"
    },
    {
      "category": "nested-interval-types",
      "detail": "INVALID_EXTRACT_BASE_FIELD_TYPE|interval literals in physical plans"
    },
    {
      "category": "nested-interval-types",
      "detail": "TABLE_OR_VIEW_NOT_FOUND.*`(arraydata|mapdata)`"
    },
    {
      "category": "variant-type",
      "detail": "The feature the variant data type"
    },
    {
      "category": "time-geo-types",
      "detail": "The feature (TIME literals|the time data type)"
    },
    {
      "category": "datetime",
      "detail": "The feature (TIMESTAMP|TIMESTAMP_NTZ|TIMESTAMP_LTZ) literals|The feature date and timestamp arithmetic"
    },
    {
      "category": "cast-matrix",
      "detail": "The feature (functions of timestamps in a session time zone|casts that read a session time zone|CAST from )"
    },
    {
      "category": "coercion",
      "detail": "The feature implicit string casts"
    },
    {
      "category": "window",
      "detail": "The feature (window functions|WINDOW clauses)"
    },
    {
      "category": "grouping-sets",
      "detail": "The feature ROLLUP"
    },
    {
      "category": "subqueries",
      "detail": "The feature correlated scalar subqueries"
    },
    {
      "category": "files",
      "detail": "The feature (glob patterns|reading the subdirectory)"
    },
    {
      "category": "object-stores",
      "detail": "The feature paths with the scheme"
    },
    {
      "category": "generators",
      "detail": "The feature (multi-name aliases|LATERAL VIEW)"
    },
    {
      "category": "hof",
      "detail": "The feature lambda functions"
    },
    {
      "category": "fn-aggregate",
      "detail": "The feature WITHIN GROUP"
    },
    {
      "category": "fn-regex",
      "detail": "(The feature function |Cannot resolve routine `)(?i)(regexp\\w*|rlike|split)\\b"
    },
    {
      "category": "fn-string",
      "family": [
        "string",
        "math"
      ]
    },
    {
      "category": "datetime",
      "family": [
        "datetime"
      ]
    },
    {
      "category": "cast-matrix",
      "family": [
        "conversion"
      ]
    },
    {
      "category": "fn-aggregate",
      "family": [
        "agg",
        "sketch"
      ]
    },
    {
      "category": "fn-array",
      "family": [
        "array",
        "collection"
      ]
    },
    {
      "category": "fn-map",
      "family": [
        "map"
      ]
    },
    {
      "category": "fn-json",
      "family": [
        "json"
      ]
    },
    {
      "category": "generators",
      "family": [
        "generator",
        "table"
      ]
    },
    {
      "category": "fn-misc",
      "family": [
        "misc",
        "vector",
        "hash",
        "conditional"
      ]
    },
    {
      "category": "hof",
      "family": [
        "lambda"
      ]
    },
    {
      "category": "fn-url-xml-csv",
      "family": [
        "url",
        "xml",
        "csv",
        "protobuf"
      ]
    },
    {
      "category": "time-geo-types",
      "family": [
        "st"
      ]
    },
    {
      "category": "output-names",
      "detail": "^schema "
    },
    {
      "category": "analyzer-bugs",
      "detail": "^no error",
      "file": "^cte$"
    }
  ],
  "spark_tag": "v4.2.0"
}
