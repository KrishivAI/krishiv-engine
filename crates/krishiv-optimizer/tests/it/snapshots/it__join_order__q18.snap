---
source: crates/krishiv-optimizer/tests/it/join_order.rs
expression: optimized.root().to_string()
---
Limit 100
+- Sort [o_totalprice#11 DESC NULLS LAST, o_orderdate#12 ASC NULLS FIRST], true
   +- Aggregate [c_name#1, c_custkey#0, o_orderkey#8, o_orderdate#12, o_totalprice#11], [c_name#1, c_custkey#0, o_orderkey#8, o_orderdate#12, o_totalprice#11, sum(l_quantity#21) AS sum(l_quantity)#50]
      +- Project [l_quantity#21, o_orderkey#8, o_totalprice#11, o_orderdate#12, c_custkey#0, c_name#1]
         +- Join Inner, (o_orderkey#8 == l_orderkey#17)
            :- Scan spark_catalog.default.lineitem [l_orderkey#17, l_quantity#21] (shared #1)
            +- Project [o_orderkey#8, o_totalprice#11, o_orderdate#12, c_custkey#0, c_name#1]
               +- Join Inner, (c_custkey#0 == o_custkey#9)
                  :- Filter ((o_orderkey#8) IN (list-query))
                  :  :  +- Project [l_orderkey#33]
                  :  :     +- Filter (sum(l_quantity)#49 > 300.00)
                  :  :        +- Aggregate [l_orderkey#33], [l_orderkey#33, sum(l_quantity#37) AS sum(l_quantity)#49]
                  :  :           +- Shift +16
                  :  :              +- Shared #1, printed above
                  :  +- Scan spark_catalog.default.orders [o_orderkey#8, o_custkey#9, o_totalprice#11, o_orderdate#12]
                  +- Scan spark_catalog.default.customer [c_custkey#0, c_name#1]
