---
source: crates/krishiv-optimizer/tests/it/rules.rs
expression: "SELECT t.a FROM t JOIN (SELECT d, count(*) AS n FROM u GROUP BY d HAVING count(*) > 1) g ON t.a = CAST(g.d AS INT) WHERE t.b = 'x'"
---
Project [a#0]
+- Join Inner, (a#0 == CAST(d#4 AS INT))
   :- Project [d#4]
   :  +- Filter (n#5 > 1L)
   :     +- Aggregate [d#4], [d#4, count(1) AS n#5]
   :        +- Scan spark_catalog.default.u [d#4]
   +- Project [a#0]
      +- Filter (b#1 == 'x')
         +- Scan spark_catalog.default.t [a#0, b#1]
