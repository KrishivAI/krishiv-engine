            +- Project [ca_state#8]
               +- Join Inner, ((i_category#94 == i_category#144) and (CAST(i_current_price#87 AS DECIMAL(14,7)) > (1.2 * avg(i_current_price)#154)))
                  :- Aggregate [i_category#144], [avg(i_current_price#137) AS avg(i_current_price)#154, i_category#144]
                  :  +- Project [i_current_price#137, i_category#144]
