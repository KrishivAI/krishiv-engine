---
source: crates/krishiv-optimizer/tests/it/rules.rs
expression: "WITH y AS (SELECT a, b, 's' AS ch, count(*) AS n FROM t GROUP BY a, b UNION ALL SELECT a, d, 'u' AS ch, count(*) AS n FROM u GROUP BY a, d) SELECT p.a FROM y p JOIN y q ON p.a = q.a WHERE p.ch = 's' AND p.b = 'x' AND q.ch = 'u' AND q.b = 'y'"
---
Project [a#9]
+- Join Inner, (a#9 == a#13)
   :- Project [a#17 AS a#9]
   :  +- Shift +17
   :     +- Union
   :        :- Aggregate [a#0, b#1], [a#0, b#1, 's' AS ch#3, count(1) AS n#4]
   :        :  +- Filter (b#1 == 'x')
   :        :     +- Scan spark_catalog.default.t [a#0, b#1] (shared #1)
   :        +- Aggregate [a#5, d#6], [a#5, d#6, 'u' AS ch#7, count(1) AS n#8]
   :           +- Filter false
   :              +- Scan spark_catalog.default.u [a#5, d#6] (shared #2)
   +- Shift +4
      +- Project [a#17 AS a#9]
         +- Shift +17
            +- Union
               :- Aggregate [a#0, b#1], [a#0, b#1, 's' AS ch#3, count(1) AS n#4]
               :  +- Filter false
               :     +- Shared #1, printed above
               +- Aggregate [a#5, d#6], [a#5, d#6, 'u' AS ch#7, count(1) AS n#8]
                  +- Filter (d#6 == 'y')
                     +- Shared #2, printed above
