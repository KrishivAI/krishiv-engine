---
source: crates/krishiv-optimizer/tests/it/tpcds.rs
expression: optimized.root().to_string()
---
Limit 100
+- Sort [c_last_name#110 ASC NULLS FIRST, c_first_name#109 ASC NULLS FIRST, ca_city#125 ASC NULLS FIRST, bought_city#98 ASC NULLS FIRST, ss_ticket_number#9 ASC NULLS FIRST], true
   +- Project [c_last_name#110, c_first_name#109, ca_city#125, bought_city#98, ss_ticket_number#9, amt#99, profit#100]
      +- Join Inner, ((c_current_addr_sk#105 == ca_address_sk#119) and (NOT (ca_city#125 == bought_city#98)))
         :- Shift +34
         :  +- Scan spark_catalog.default.customer_address [ca_address_sk#85, ca_city#91] (shared #1)
         +- Project [c_current_addr_sk#105, c_first_name#109, c_last_name#110, ss_ticket_number#9, bought_city#98, amt#99, profit#100]
            +- Join Inner, (ss_customer_sk#3 == c_customer_sk#101)
               :- Scan spark_catalog.default.customer [c_customer_sk#101, c_current_addr_sk#105, c_first_name#109, c_last_name#110]
               +- Aggregate [ss_ticket_number#9, ss_customer_sk#3, ss_addr_sk#6, ca_city#91], [ss_ticket_number#9, ss_customer_sk#3, ca_city#91 AS bought_city#98, sum(ss_coupon_amt#19) AS amt#99, sum(ss_net_profit#22) AS profit#100]
                  +- Project [ca_city#91, ss_customer_sk#3, ss_addr_sk#6, ss_ticket_number#9, ss_coupon_amt#19, ss_net_profit#22]
                     +- Join Inner, (ss_addr_sk#6 == ca_address_sk#85)
                        :- Shared #1, printed above
                        +- Project [ss_customer_sk#3, ss_addr_sk#6, ss_ticket_number#9, ss_coupon_amt#19, ss_net_profit#22]
                           +- Join Inner, (ss_hdemo_sk#5 == hd_demo_sk#80)
                              :- Project [hd_demo_sk#80]
                              :  +- Filter ((hd_dep_count#83 == 4) or (hd_vehicle_count#84 == 3))
                              :     +- Scan spark_catalog.default.household_demographics [hd_demo_sk#80, hd_dep_count#83, hd_vehicle_count#84]
                              +- Project [ss_customer_sk#3, ss_hdemo_sk#5, ss_addr_sk#6, ss_ticket_number#9, ss_coupon_amt#19, ss_net_profit#22]
                                 +- Join Inner, (ss_store_sk#7 == s_store_sk#51)
                                    :- Project [s_store_sk#51]
                                    :  +- Filter (s_city#73 IN ('Fairview', 'Midway'))
                                    :     +- Scan spark_catalog.default.store [s_store_sk#51, s_city#73]
                                    +- Project [ss_customer_sk#3, ss_hdemo_sk#5, ss_addr_sk#6, ss_store_sk#7, ss_ticket_number#9, ss_coupon_amt#19, ss_net_profit#22]
                                       +- Join Inner, (ss_sold_date_sk#0 == d_date_sk#23)
                                          :- Scan spark_catalog.default.store_sales [ss_sold_date_sk#0, ss_customer_sk#3, ss_hdemo_sk#5, ss_addr_sk#6, ss_store_sk#7, ss_ticket_number#9, ss_coupon_amt#19, ss_net_profit#22]
                                          +- Project [d_date_sk#23]
                                             +- Filter ((d_dow#30 IN (6, 0)) and (d_year#29 IN (1999, 2000, 2001)))
                                                +- Scan spark_catalog.default.date_dim [d_date_sk#23, d_year#29, d_dow#30]
