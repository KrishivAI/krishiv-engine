---
source: crates/krishiv-optimizer/tests/it/tpcds.rs
expression: optimized.root().to_string()
---
Limit 100
+- Sort [c_last_name#111 ASC NULLS FIRST, ss_ticket_number#9 ASC NULLS FIRST], true
   +- Project [c_last_name#111, c_first_name#110, ca_city#126, bought_city#98, ss_ticket_number#9, extended_price#99, extended_tax#101, list_price#100]
      +- Join Inner, ((NOT (ca_city#126 == bought_city#98)) and (ss_customer_sk#3 == c_customer_sk#102))
         :- Aggregate [ss_ticket_number#9, ss_customer_sk#3, ss_addr_sk#6, ca_city#91], [ss_ticket_number#9, ss_customer_sk#3, ca_city#91 AS bought_city#98, sum(ss_ext_sales_price#15) AS extended_price#99, sum(ss_ext_list_price#17) AS list_price#100, sum(ss_ext_tax#18) AS extended_tax#101]
         :  +- Project [ss_customer_sk#3, ss_addr_sk#6, ss_ticket_number#9, ss_ext_sales_price#15, ss_ext_list_price#17, ss_ext_tax#18, ca_city#91]
         :     +- Join Inner, (ss_addr_sk#6 == ca_address_sk#85)
         :        :- Project [ss_customer_sk#3, ss_addr_sk#6, ss_ticket_number#9, ss_ext_sales_price#15, ss_ext_list_price#17, ss_ext_tax#18]
         :        :  +- Join Inner, (ss_hdemo_sk#5 == hd_demo_sk#80)
         :        :     :- Project [ss_customer_sk#3, ss_hdemo_sk#5, ss_addr_sk#6, ss_ticket_number#9, ss_ext_sales_price#15, ss_ext_list_price#17, ss_ext_tax#18]
         :        :     :  +- Join Inner, (ss_store_sk#7 == s_store_sk#51)
         :        :     :     :- Project [ss_customer_sk#3, ss_hdemo_sk#5, ss_addr_sk#6, ss_store_sk#7, ss_ticket_number#9, ss_ext_sales_price#15, ss_ext_list_price#17, ss_ext_tax#18]
         :        :     :     :  +- Join Inner, (ss_sold_date_sk#0 == d_date_sk#23)
         :        :     :     :     :- Scan spark_catalog.default.store_sales [ss_sold_date_sk#0, ss_customer_sk#3, ss_hdemo_sk#5, ss_addr_sk#6, ss_store_sk#7, ss_ticket_number#9, ss_ext_sales_price#15, ss_ext_list_price#17, ss_ext_tax#18]
         :        :     :     :     +- Project [d_date_sk#23]
         :        :     :     :        +- Filter (((d_dom#32 >= 1) and (d_dom#32 <= 2)) and (d_year#29 IN (1999, 2000, 2001)))
         :        :     :     :           +- Scan spark_catalog.default.date_dim [d_date_sk#23, d_year#29, d_dom#32]
         :        :     :     +- Project [s_store_sk#51]
         :        :     :        +- Filter (s_city#73 IN ('Fairview', 'Midway'))
         :        :     :           +- Scan spark_catalog.default.store [s_store_sk#51, s_city#73]
         :        :     +- Project [hd_demo_sk#80]
         :        :        +- Filter ((hd_dep_count#83 == 4) or (hd_vehicle_count#84 == 3))
         :        :           +- Scan spark_catalog.default.household_demographics [hd_demo_sk#80, hd_dep_count#83, hd_vehicle_count#84]
         :        +- Scan spark_catalog.default.customer_address [ca_address_sk#85, ca_city#91] (shared #1)
         +- Project [c_customer_sk#102, c_first_name#110, c_last_name#111, ca_city#126]
            +- Join Inner, (c_current_addr_sk#106 == ca_address_sk#120)
               :- Scan spark_catalog.default.customer [c_customer_sk#102, c_current_addr_sk#106, c_first_name#110, c_last_name#111]
               +- Shift +35
                  +- Shared #1, printed above
