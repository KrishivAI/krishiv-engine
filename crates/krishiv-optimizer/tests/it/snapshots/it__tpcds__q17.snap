                        :     +- Scan spark_catalog.default.date_dim [d_date_sk#77, d_quarter_name#92] (shared #1)
                        +- Project [ss_sold_date_sk#0, ss_item_sk#2, ss_store_sk#7, ss_quantity#10, sr_return_quantity#33, cs_quantity#61]
                           +- Join Inner, (((ss_customer_sk#3 == sr_customer_sk#26) and (ss_item_sk#2 == sr_item_sk#25)) and (ss_ticket_number#9 == sr_ticket_number#32))
                              :- Scan spark_catalog.default.store_sales [ss_sold_date_sk#0, ss_item_sk#2, ss_customer_sk#3, ss_store_sk#7, ss_ticket_number#9, ss_quantity#10]
                              +- Project [sr_item_sk#25, sr_customer_sk#26, sr_ticket_number#32, sr_return_quantity#33, cs_quantity#61]
                                 +- Join Inner, (sr_returned_date_sk#23 == d_date_sk#105)
                                    :- Project [sr_returned_date_sk#23, sr_item_sk#25, sr_customer_sk#26, sr_ticket_number#32, sr_return_quantity#33, cs_quantity#61]
                                    :  +- Join Inner, ((sr_customer_sk#26 == cs_bill_customer_sk#46) and (sr_item_sk#25 == cs_item_sk#58))
                                    :     :- Scan spark_catalog.default.store_returns [sr_returned_date_sk#23, sr_item_sk#25, sr_customer_sk#26, sr_ticket_number#32, sr_return_quantity#33]
                                    :     +- Project [cs_bill_customer_sk#46, cs_item_sk#58, cs_quantity#61]
