Limit 100
+- Sort [i_item_id#191 ASC NULLS FIRST, i_item_desc#194 ASC NULLS FIRST, s_state#185 ASC NULLS FIRST], true
   +- Aggregate [i_item_id#191, i_item_desc#194, s_state#185], [i_item_id#191, i_item_desc#194, s_state#185, count(ss_quantity#10) AS store_sales_quantitycount#212, avg(ss_quantity#10) AS store_sales_quantityave#213, stddev_samp(cse_0#4294967296) AS store_sales_quantitystdev#214, (stddev_samp(cse_0#4294967296) / avg(ss_quantity#10)) AS store_sales_quantitycov#215, count(sr_return_quantity#33) AS store_returns_quantitycount#216, avg(sr_return_quantity#33) AS store_returns_quantityave#217, stddev_samp(cse_1#4294967297) AS store_returns_quantitystdev#218, (stddev_samp(cse_1#4294967297) / avg(sr_return_quantity#33)) AS store_returns_quantitycov#219, count(cs_quantity#61) AS catalog_sales_quantitycount#220, avg(cs_quantity#61) AS catalog_sales_quantityave#221, stddev_samp(cse_2#4294967298) AS catalog_sales_quantitystdev#222, (stddev_samp(cse_2#4294967298) / avg(cs_quantity#61)) AS catalog_sales_quantitycov#223]
      +- Project [s_state#185, i_item_id#191, i_item_desc#194, ss_quantity#10, sr_return_quantity#33, cs_quantity#61, CAST(ss_quantity#10 AS DOUBLE) AS cse_0#4294967296, CAST(sr_return_quantity#33 AS DOUBLE) AS cse_1#4294967297, CAST(cs_quantity#61 AS DOUBLE) AS cse_2#4294967298]
         +- Join Inner, (s_store_sk#161 == ss_store_sk#7)
