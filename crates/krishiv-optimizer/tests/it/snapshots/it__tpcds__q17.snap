            +- Project [i_item_id#191, i_item_desc#194, ss_store_sk#7, ss_quantity#10, sr_return_quantity#33, cs_quantity#61]
               +- Join Inner, (i_item_sk#190 == ss_item_sk#2)
                  :- Scan spark_catalog.default.item [i_item_sk#190, i_item_id#191, i_item_desc#194]
                  +- Project [ss_item_sk#2, ss_store_sk#7, ss_quantity#10, sr_return_quantity#33, cs_quantity#61]
                     +- Join Inner, (d_date_sk#77 == ss_sold_date_sk#0)
                        :- Project [d_date_sk#77]
