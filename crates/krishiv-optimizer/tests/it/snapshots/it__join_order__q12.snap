---
source: crates/krishiv-optimizer/tests/it/join_order.rs
expression: optimized.root().to_string()
---
Sort [l_shipmode#23 ASC NULLS FIRST], true
+- Aggregate [l_shipmode#23], [l_shipmode#23, sum(CASE WHEN ((o_orderpriority#5 == '1-URGENT') or (o_orderpriority#5 == '2-HIGH')) THEN 1 ELSE 0 END) AS high_line_count#25, sum(CASE WHEN ((NOT (o_orderpriority#5 == '1-URGENT')) and (NOT (o_orderpriority#5 == '2-HIGH'))) THEN 1 ELSE 0 END) AS low_line_count#26]
   +- Project [o_orderpriority#5, l_shipmode#23]
      +- Join Inner, (o_orderkey#0 == l_orderkey#9)
         :- Scan spark_catalog.default.orders [o_orderkey#0, o_orderpriority#5]
         +- Project [l_orderkey#9, l_shipmode#23]
            +- Filter (((((l_shipmode#23 IN ('MAIL', 'SHIP')) and (l_commitdate#20 < l_receiptdate#21)) and (l_shipdate#19 < l_commitdate#20)) and (l_receiptdate#21 >= DATE '1994-01-01')) and (l_receiptdate#21 < DATE '1995-01-01'))
               +- Scan spark_catalog.default.lineitem [l_orderkey#9, l_shipdate#19, l_commitdate#20, l_receiptdate#21, l_shipmode#23]
