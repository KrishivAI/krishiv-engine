---
source: crates/krishiv-optimizer/tests/it/rules.rs
expression: "SELECT g.a, h1.d, h2.d FROM (SELECT a FROM t WHERE a = 5) g LEFT JOIN u h1 ON g.a = h1.a LEFT JOIN u h2 ON g.a = h2.a"
---
Project [a#0, d#4, d#6]
+- Join LeftOuter, (a#0 == a#5)
   :- Project [a#0, d#4]
   :  +- Join LeftOuter, (a#0 == a#3)
   :     :- Filter (a#0 == 5)
   :     :  +- Scan spark_catalog.default.t [a#0]
   :     +- Filter (isnotnull(a#3) and (a#3 == 5))
   :        +- Scan spark_catalog.default.u [a#3, d#4] (shared #1)
   +- Shift +2
      +- Filter (isnotnull(a#3) and (a#3 == 5))
         +- Shared #1, printed above
