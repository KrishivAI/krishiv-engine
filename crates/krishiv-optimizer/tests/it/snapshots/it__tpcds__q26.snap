---
source: crates/krishiv-optimizer/tests/it/tpcds.rs
expression: optimized.root().to_string()
---
Limit 100
+- Sort [i_item_id#72 ASC NULLS FIRST], true
   +- Aggregate [i_item_id#72], [i_item_id#72, avg(cs_quantity#18) AS agg1#112, avg(cs_list_price#20) AS agg2#113, avg(cs_coupon_amt#27) AS agg3#114, avg(cs_sales_price#21) AS agg4#115]
      +- Project [i_item_id#72, cs_quantity#18, cs_list_price#20, cs_sales_price#21, cs_coupon_amt#27]
         +- Join Inner, (cs_item_sk#15 == i_item_sk#71)
            :- Scan spark_catalog.default.item [i_item_sk#71, i_item_id#72]
            +- Project [cs_item_sk#15, cs_quantity#18, cs_list_price#20, cs_sales_price#21, cs_coupon_amt#27]
               +- Join Inner, (cs_promo_sk#16 == p_promo_sk#93)
                  :- Project [p_promo_sk#93]
                  :  +- Filter ((p_channel_email#102 == 'N') or (p_channel_event#107 == 'N'))
                  :     +- Scan spark_catalog.default.promotion [p_promo_sk#93, p_channel_email#102, p_channel_event#107]
                  +- Project [cs_item_sk#15, cs_promo_sk#16, cs_quantity#18, cs_list_price#20, cs_sales_price#21, cs_coupon_amt#27]
                     +- Join Inner, (cs_sold_date_sk#0 == d_date_sk#43)
                        :- Project [d_date_sk#43]
                        :  +- Filter (d_year#49 == 2000)
                        :     +- Scan spark_catalog.default.date_dim [d_date_sk#43, d_year#49]
                        +- Project [cs_sold_date_sk#0, cs_item_sk#15, cs_promo_sk#16, cs_quantity#18, cs_list_price#20, cs_sales_price#21, cs_coupon_amt#27]
                           +- Join Inner, (cs_bill_cdemo_sk#4 == cd_demo_sk#34)
                              :- Scan spark_catalog.default.catalog_sales [cs_sold_date_sk#0, cs_bill_cdemo_sk#4, cs_item_sk#15, cs_promo_sk#16, cs_quantity#18, cs_list_price#20, cs_sales_price#21, cs_coupon_amt#27]
                              +- Project [cd_demo_sk#34]
                                 +- Filter (((cd_gender#35 == 'M') and (cd_marital_status#36 == 'S')) and (cd_education_status#37 == 'College'))
                                    +- Scan spark_catalog.default.customer_demographics [cd_demo_sk#34, cd_gender#35, cd_marital_status#36, cd_education_status#37]
