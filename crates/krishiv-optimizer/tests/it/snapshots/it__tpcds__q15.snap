---
source: crates/krishiv-optimizer/tests/it/tpcds.rs
expression: optimized.root().to_string()
---
Limit 100
+- Sort [ca_zip#61 ASC NULLS FIRST], true
   +- Aggregate [ca_zip#61], [ca_zip#61, sum(cs_sales_price#21) AS sum(cs_sales_price)#93]
      +- Project [ca_zip#61, cs_sales_price#21]
         +- Join Inner, ((c_current_addr_sk#38 == ca_address_sk#52) and (((substring(ca_zip#61, 1, 5) IN ('85669', '86197', '88274', '83405', '86475', '85392', '85460', '80348', '81792')) or (ca_state#60 IN ('CA', 'WA', 'GA'))) or (cs_sales_price#21 > 500.00)))
            :- Scan spark_catalog.default.customer_address [ca_address_sk#52, ca_state#60, ca_zip#61]
            +- Project [c_current_addr_sk#38, cs_sales_price#21]
               +- Join Inner, (cs_bill_customer_sk#3 == c_customer_sk#34)
                  :- Scan spark_catalog.default.customer [c_customer_sk#34, c_current_addr_sk#38]
                  +- Project [cs_bill_customer_sk#3, cs_sales_price#21]
                     +- Join Inner, (cs_sold_date_sk#0 == d_date_sk#65)
                        :- Scan spark_catalog.default.catalog_sales [cs_sold_date_sk#0, cs_bill_customer_sk#3, cs_sales_price#21]
                        +- Project [d_date_sk#65]
                           +- Filter ((d_qoy#75 == 2) and (d_year#71 == 2001))
                              +- Scan spark_catalog.default.date_dim [d_date_sk#65, d_year#71, d_qoy#75]
