---
source: crates/krishiv-optimizer/tests/it/rules.rs
expression: "SELECT t.a FROM t JOIN (SELECT CAST(a AS DOUBLE) AS k, count(*) AS n FROM u GROUP BY CAST(a AS DOUBLE)) g ON CAST(t.a AS DOUBLE) = g.k WHERE t.b = 'x'"
---
Project [a#0]
+- Join Inner, (CAST(a#0 AS DOUBLE) == k#5)
   :- Aggregate [CAST(a#3 AS DOUBLE)], [CAST(a#3 AS DOUBLE) AS k#5]
   :  +- Scan spark_catalog.default.u [a#3]
   +- Project [a#0]
      +- Filter (b#1 == 'x')
         +- Scan spark_catalog.default.t [a#0, b#1]
