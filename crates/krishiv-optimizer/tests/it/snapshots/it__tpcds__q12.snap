---
source: crates/krishiv-optimizer/tests/it/tpcds.rs
expression: optimized.root().to_string()
---
Limit 100
+- Sort [i_category#46 ASC NULLS FIRST, i_class#44 ASC NULLS FIRST, i_item_id#35 ASC NULLS FIRST, i_item_desc#38 ASC NULLS FIRST, revenueratio#85 ASC NULLS FIRST], true
   +- Project [i_item_id#35, i_item_desc#38, i_category#46, i_class#44, i_current_price#39, itemrevenue#84, ((itemrevenue#84 * 100.0000) / _we0#86) AS revenueratio#85]
      +- Window [sum(itemrevenue#84) OVER (PARTITION BY i_class#44 ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS _we0#86], [i_class#44], []
         +- Aggregate [i_item_id#35, i_item_desc#38, i_category#46, i_class#44, i_current_price#39], [i_item_id#35, i_item_desc#38, i_category#46, i_class#44, i_current_price#39, sum(ws_ext_sales_price#23) AS itemrevenue#84]
            +- Project [i_item_id#35, i_item_desc#38, i_current_price#39, i_class#44, i_category#46, ws_ext_sales_price#23]
               +- Join Inner, (ws_item_sk#3 == i_item_sk#34)
                  :- Filter (i_category#46 IN ('Sports', 'Books', 'Home'))
                  :  +- Scan spark_catalog.default.item [i_item_sk#34, i_item_id#35, i_item_desc#38, i_current_price#39, i_class#44, i_category#46]
                  +- Project [ws_item_sk#3, ws_ext_sales_price#23]
                     +- Join Inner, (ws_sold_date_sk#0 == d_date_sk#56)
                        :- Scan spark_catalog.default.web_sales [ws_sold_date_sk#0, ws_item_sk#3, ws_ext_sales_price#23]
                        +- Project [d_date_sk#56]
                           +- Filter ((d_date#58 >= DATE '1999-02-22') and (d_date#58 <= DATE '1999-03-24'))
                              +- Scan spark_catalog.default.date_dim [d_date_sk#56, d_date#58]
