:- Aggregate [d_week_seq#78], [d_week_seq#78, sum(CASE WHEN (d_day_name#88 == 'Sunday') THEN sales_price#73 ELSE CAST(NULL AS DECIMAL(7,2)) END) AS sun_sales#102, sum(CASE WHEN (d_day_name#88 == 'Monday') THEN sales_price#73 ELSE CAST(NULL AS DECIMAL(7,2)) END) AS mon_sales#103, sum(CASE WHEN (d_day_name#88 == 'Tuesday') THEN sales_price#73 ELSE CAST(NULL AS DECIMAL(7,2)) END) AS tue_sales#104, sum(CASE WHEN (d_day_name#88 == 'Wednesday') THEN sales_price#73 ELSE CAST(NULL AS DECIMAL(7,2)) END) AS wed_sales#105, sum(CASE WHEN (d_day_name#88 == 'Thursday') THEN sales_price#73 ELSE CAST(NULL AS DECIMAL(7,2)) END) AS thu_sales#106, sum(CASE WHEN (d_day_name#88 == 'Friday') THEN sales_price#73 ELSE CAST(NULL AS DECIMAL(7,2)) END) AS fri_sales#107, sum(CASE WHEN (d_day_name#88 == 'Saturday') THEN sales_price#73 ELSE CAST(NULL AS DECIMAL(7,2)) END) AS sat_sales#108]
:  +- Project [sales_price#73, d_week_seq#78, d_day_name#88]
