---
source: crates/krishiv-optimizer/tests/it/join_order.rs
expression: optimized.root().to_string()
---
Aggregate [], [count(1) AS count(1)#33]
+- Project [l_orderkey#0]
   +- Join Inner, ((l_orderkey#0 == o_orderkey#16) and (((l_quantity#4 > 10.00) and (c_acctbal#30 > 0.00)) or ((l_quantity#4 < 5.00) and (o_totalprice#19 > 100.00))))
      :- Filter ((l_quantity#4 > 10.00) or (l_quantity#4 < 5.00))
      :  +- Scan spark_catalog.default.lineitem [l_orderkey#0, l_quantity#4]
      +- Project [o_orderkey#16, o_totalprice#19, c_acctbal#30]
         +- Join Inner, (o_custkey#17 == c_custkey#25)
            :- Scan spark_catalog.default.orders [o_orderkey#16, o_custkey#17, o_totalprice#19]
            +- Scan spark_catalog.default.customer [c_custkey#25, c_acctbal#30]
