---
source: crates/krishiv-optimizer/tests/it/join_order.rs
expression: optimized.root().to_string()
---
Sort [s_name#1 ASC NULLS FIRST], true
+- Project [s_name#1, s_address#2]
   +- Join LeftSemi, (s_suppkey#0 == ps_suppkey#12)
      :- Project [s_suppkey#0, s_name#1, s_address#2]
      :  +- Join Inner, (s_nationkey#3 == n_nationkey#7)
      :     :- Scan spark_catalog.default.supplier [s_suppkey#0, s_name#1, s_address#2, s_nationkey#3]
      :     +- Project [n_nationkey#7]
      :        +- Filter (n_name#8 == 'CANADA')
      :           +- Scan spark_catalog.default.nation [n_nationkey#7, n_name#8]
      +- Project [ps_suppkey#12]
         +- Join Inner, (((ps_partkey#11 == l_partkey#26) and (ps_suppkey#12 == l_suppkey#27)) and (CAST(ps_availqty#13 AS DECIMAL(27,3)) > (0.5 * sum(l_quantity))#41))
            :- Aggregate [l_partkey#26, l_suppkey#27], [(0.5 * sum(l_quantity#29)) AS (0.5 * sum(l_quantity))#41, l_partkey#26, l_suppkey#27]
            :  +- Project [l_partkey#26, l_suppkey#27, l_quantity#29]
            :     +- Filter ((l_shipdate#35 >= DATE '1994-01-01') and (l_shipdate#35 < DATE '1995-01-01'))
            :        +- Scan spark_catalog.default.lineitem [l_partkey#26, l_suppkey#27, l_quantity#29, l_shipdate#35]
            +- Join LeftSemi, (ps_partkey#11 == p_partkey#16)
               :- Scan spark_catalog.default.partsupp [ps_partkey#11, ps_suppkey#12, ps_availqty#13]
               +- Project [p_partkey#16]
                  +- Filter (p_name#17 like 'forest%')
                     +- Scan spark_catalog.default.part [p_partkey#16, p_name#17]
