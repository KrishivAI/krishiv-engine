---
source: crates/krishiv-optimizer/tests/it/tpcds.rs
expression: optimized.root().to_string()
---
Limit 100
+- Sort [w_substr#48 ASC NULLS FIRST, sm_type#51 ASC NULLS FIRST, web_name#59 ASC NULLS FIRST], true
   +- Aggregate [w_substr#48, sm_type#51, web_name#59], [w_substr#48, sm_type#51, web_name#59, sum(CASE WHEN (krishiv_cse_0#4294967296 <= 30) THEN 1 ELSE 0 END) AS 30 days#109, sum(CASE WHEN ((krishiv_cse_0#4294967296 > 30) and (krishiv_cse_0#4294967296 <= 60)) THEN 1 ELSE 0 END) AS 31-60 days#110, sum(CASE WHEN ((krishiv_cse_0#4294967296 > 60) and (krishiv_cse_0#4294967296 <= 90)) THEN 1 ELSE 0 END) AS 61-90 days#111, sum(CASE WHEN ((krishiv_cse_0#4294967296 > 90) and (krishiv_cse_0#4294967296 <= 120)) THEN 1 ELSE 0 END) AS 91-120 days#112, sum(CASE WHEN (krishiv_cse_0#4294967296 > 120) THEN 1 ELSE 0 END) AS >120 days#113]
      +- Project [w_substr#48, sm_type#51, web_name#59, (ws_ship_date_sk#2 - ws_sold_date_sk#0) AS krishiv_cse_0#4294967296]
         +- Join Inner, (ws_warehouse_sk#15 == w_warehouse_sk#34)
            :- Project [substring(w_warehouse_name#36, 1, 20) AS w_substr#48, w_warehouse_sk#34]
            :  +- Filter isnotnull(w_warehouse_sk#34)
            :     +- Scan spark_catalog.default.warehouse [w_warehouse_sk#34, w_warehouse_name#36]
            +- Project [sm_type#51, web_name#59, ws_sold_date_sk#0, ws_ship_date_sk#2, ws_warehouse_sk#15]
               +- Join Inner, (ws_ship_mode_sk#14 == sm_ship_mode_sk#49)
                  :- Filter isnotnull(sm_ship_mode_sk#49)
                  :  +- Scan spark_catalog.default.ship_mode [sm_ship_mode_sk#49, sm_type#51]
                  +- Project [web_name#59, ws_sold_date_sk#0, ws_ship_date_sk#2, ws_ship_mode_sk#14, ws_warehouse_sk#15]
                     +- Join Inner, (ws_web_site_sk#13 == web_site_sk#55)
                        :- Filter isnotnull(web_site_sk#55)
                        :  +- Scan spark_catalog.default.web_site [web_site_sk#55, web_name#59]
                        +- Project [ws_sold_date_sk#0, ws_ship_date_sk#2, ws_web_site_sk#13, ws_ship_mode_sk#14, ws_warehouse_sk#15]
                           +- Join Inner, (ws_ship_date_sk#2 == d_date_sk#81)
                              :- Filter (((isnotnull(ws_ship_date_sk#2) and isnotnull(ws_web_site_sk#13)) and isnotnull(ws_ship_mode_sk#14)) and isnotnull(ws_warehouse_sk#15))
                              :  +- Scan spark_catalog.default.web_sales [ws_sold_date_sk#0, ws_ship_date_sk#2, ws_web_site_sk#13, ws_ship_mode_sk#14, ws_warehouse_sk#15]
                              +- Project [d_date_sk#81]
                                 +- Filter (((d_month_seq#84 >= 1200) and (d_month_seq#84 <= 1211)) and isnotnull(d_date_sk#81))
                                    +- Scan spark_catalog.default.date_dim [d_date_sk#81, d_month_seq#84]
