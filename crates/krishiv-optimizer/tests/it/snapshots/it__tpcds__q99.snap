---
source: crates/krishiv-optimizer/tests/it/tpcds.rs
expression: optimized.root().to_string()
---
Limit 100
+- Sort [w_substr#48 ASC NULLS FIRST, sm_type#51 ASC NULLS FIRST, cc_name_lower#114 ASC NULLS FIRST], true
   +- Aggregate [w_substr#48, sm_type#51, cc_name#61], [w_substr#48, sm_type#51, lower(cc_name#61) AS cc_name_lower#114, sum(CASE WHEN (krishiv_cse_0#4294967296 <= 30) THEN 1 ELSE 0 END) AS 30 days#115, sum(CASE WHEN ((krishiv_cse_0#4294967296 > 30) and (krishiv_cse_0#4294967296 <= 60)) THEN 1 ELSE 0 END) AS 31-60 days#116, sum(CASE WHEN ((krishiv_cse_0#4294967296 > 60) and (krishiv_cse_0#4294967296 <= 90)) THEN 1 ELSE 0 END) AS 61-90 days#117, sum(CASE WHEN ((krishiv_cse_0#4294967296 > 90) and (krishiv_cse_0#4294967296 <= 120)) THEN 1 ELSE 0 END) AS 91-120 days#118, sum(CASE WHEN (krishiv_cse_0#4294967296 > 120) THEN 1 ELSE 0 END) AS >120 days#119]
      +- Project [w_substr#48, sm_type#51, cc_name#61, (cs_ship_date_sk#2 - cs_sold_date_sk#0) AS krishiv_cse_0#4294967296]
         +- Join Inner, (cs_warehouse_sk#14 == w_warehouse_sk#34)
            :- Project [substring(w_warehouse_name#36, 1, 20) AS w_substr#48, w_warehouse_sk#34]
            :  +- Scan spark_catalog.default.warehouse [w_warehouse_sk#34, w_warehouse_name#36]
            +- Project [sm_type#51, cc_name#61, cs_sold_date_sk#0, cs_ship_date_sk#2, cs_warehouse_sk#14]
               +- Join Inner, (cs_ship_mode_sk#13 == sm_ship_mode_sk#49)
                  :- Scan spark_catalog.default.ship_mode [sm_ship_mode_sk#49, sm_type#51]
                  +- Project [cc_name#61, cs_sold_date_sk#0, cs_ship_date_sk#2, cs_ship_mode_sk#13, cs_warehouse_sk#14]
                     +- Join Inner, (cs_call_center_sk#11 == cc_call_center_sk#55)
                        :- Scan spark_catalog.default.call_center [cc_call_center_sk#55, cc_name#61]
                        +- Project [cs_sold_date_sk#0, cs_ship_date_sk#2, cs_call_center_sk#11, cs_ship_mode_sk#13, cs_warehouse_sk#14]
                           +- Join Inner, (cs_ship_date_sk#2 == d_date_sk#86)
                              :- Scan spark_catalog.default.catalog_sales [cs_sold_date_sk#0, cs_ship_date_sk#2, cs_call_center_sk#11, cs_ship_mode_sk#13, cs_warehouse_sk#14]
                              +- Project [d_date_sk#86]
                                 +- Filter ((d_month_seq#89 >= 1200) and (d_month_seq#89 <= 1211))
                                    +- Scan spark_catalog.default.date_dim [d_date_sk#86, d_month_seq#89]
