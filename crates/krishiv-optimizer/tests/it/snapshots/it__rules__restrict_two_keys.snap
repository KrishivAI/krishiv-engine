---
source: crates/krishiv-optimizer/tests/it/rules.rs
expression: "SELECT a FROM t WHERE b = 'x' AND c > (SELECT count(*) FROM u WHERE u.a = t.a AND u.d = t.b)"
---
Project [a#0]
+- Filter (c#2 > CASE WHEN isnull(count(1)#5) THEN 0L ELSE count(1)#5 END)
   +- Join LeftOuter, ((a#0 == a#3) and (b#1 == d#4))
      :- Filter (b#1 == 'x')
      :  +- Scan spark_catalog.default.t [a#0, b#1, c#2]
      +- Aggregate [a#3, d#4], [count(1) AS count(1)#5, a#3, d#4]
         +- Filter ((isnotnull(a#3) and isnotnull(d#4)) and (d#4 == 'x'))
            +- Scan spark_catalog.default.u [a#3, d#4]
