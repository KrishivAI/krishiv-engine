Project [total_sum#85, i_category#88, i_class#89, lochierarchy#86, rank_within_parent#87]
+- Limit 100
   +- Sort [lochierarchy#86 DESC NULLS FIRST, CASE WHEN (CAST((CAST(((grouping__id#84 div 2L) % 2L) AS TINYINT) + CAST((grouping__id#84 % 2L) AS TINYINT)) AS INT) == 0) THEN i_category#88 END ASC NULLS FIRST, rank_within_parent#87 ASC NULLS FIRST], true
      +- Project [total_sum#85, i_category#88, i_class#89, lochierarchy#86, _we0#95 AS rank_within_parent#87, grouping__id#84]
         +- Window [rank() OVER (PARTITION BY _w0#93, _w1#94 ORDER BY total_sum#85 DESC NULLS LAST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS _we0#95], [_w0#93, _w1#94], [total_sum#85 DESC NULLS LAST]
            +- Aggregate [i_category#88, i_class#89, spark_grouping_id#84], [sum(state(sum#sum#96, sum#nonempty#97)) AS total_sum#85, i_category#88, i_class#89, (CAST(((grouping__id#84 div 2L) % 2L) AS TINYINT) + CAST((grouping__id#84 % 2L) AS TINYINT)) AS lochierarchy#86, grouping__id#84, (CAST(((grouping__id#84 div 2L) % 2L) AS TINYINT) + CAST((grouping__id#84 % 2L) AS TINYINT)) AS _w0#93, CASE WHEN (CAST(CAST((grouping__id#84 % 2L) AS TINYINT) AS INT) == 0) THEN i_category#88 END AS _w1#94]
               +- Expand [[i_category#74, i_class#72, 0L, sum#sum#96, sum#nonempty#97], [i_category#74, CAST(NULL AS STRING), 1L, sum#sum#96, sum#nonempty#97], [CAST(NULL AS STRING), CAST(NULL AS STRING), 3L, sum#sum#96, sum#nonempty#97]], [i_category#88, i_class#89, spark_grouping_id#84, sum#sum#96, sum#nonempty#97]
                  +- PartialAggregate [i_class#72, i_category#74], [sum(ws_net_paid#29)]
                     +- Join Inner, (i_item_sk#62 == ws_item_sk#3)
                        :- Filter isnotnull(i_item_sk#62)
                        :  +- Scan spark_catalog.default.item [i_item_sk#62, i_class#72, i_category#74]
                        +- Project [ws_item_sk#3, ws_net_paid#29]
                           +- Join Inner, (d_date_sk#34 == ws_sold_date_sk#0)
                              :- Filter (isnotnull(ws_item_sk#3) and isnotnull(ws_sold_date_sk#0))
                              :  +- Scan spark_catalog.default.web_sales [ws_sold_date_sk#0, ws_item_sk#3, ws_net_paid#29]
                              +- Project [d_date_sk#34]
                                 +- Filter ((isnotnull(d_date_sk#34) and (d_month_seq#37 <= 1211)) and (d_month_seq#37 >= 1200))
                                    +- Scan spark_catalog.default.date_dim [d_date_sk#34, d_month_seq#37]
