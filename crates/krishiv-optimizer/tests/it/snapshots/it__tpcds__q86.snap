               +- Expand [[ws_net_paid#29, i_category#74, i_class#72, 0L], [ws_net_paid#29, i_category#74, CAST(NULL AS STRING), 1L], [ws_net_paid#29, CAST(NULL AS STRING), CAST(NULL AS STRING), 3L]], [ws_net_paid#29, i_category#88, i_class#89, spark_grouping_id#84]
                  +- Join Inner, (i_item_sk#62 == ws_item_sk#3)
