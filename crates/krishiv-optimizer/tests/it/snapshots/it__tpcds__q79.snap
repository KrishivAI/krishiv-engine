Project [c_last_name#96, c_first_name#95, substring(s_city, 1, 30)#105, ss_ticket_number#9, amt#85, profit#86]
+- Limit 100
   +- Sort [c_last_name#96 ASC NULLS FIRST, c_first_name#95 ASC NULLS FIRST, substring(s_city#73, 1, 30) ASC NULLS FIRST, profit#86 ASC NULLS FIRST, ss_ticket_number#9 ASC NULLS FIRST], true
      +- Project [c_last_name#96, c_first_name#95, substring(s_city#73, 1, 30) AS substring(s_city, 1, 30)#105, ss_ticket_number#9, amt#85, profit#86, s_city#73]
         +- Join Inner, (ss_customer_sk#3 == c_customer_sk#87)
            :- Aggregate [ss_ticket_number#9, ss_customer_sk#3, ss_addr_sk#6, s_city#73], [ss_ticket_number#9, ss_customer_sk#3, s_city#73, sum(ss_coupon_amt#19) AS amt#85, sum(ss_net_profit#22) AS profit#86]
            :  +- Project [ss_customer_sk#3, ss_addr_sk#6, ss_ticket_number#9, ss_coupon_amt#19, ss_net_profit#22, s_city#73]
            :     +- Join Inner, (ss_hdemo_sk#5 == hd_demo_sk#80)
            :        :- Project [ss_customer_sk#3, ss_hdemo_sk#5, ss_addr_sk#6, ss_ticket_number#9, ss_coupon_amt#19, ss_net_profit#22, s_city#73]
            :        :  +- Join Inner, (ss_store_sk#7 == s_store_sk#51)
            :        :     :- Project [ss_customer_sk#3, ss_hdemo_sk#5, ss_addr_sk#6, ss_store_sk#7, ss_ticket_number#9, ss_coupon_amt#19, ss_net_profit#22]
            :        :     :  +- Join Inner, (ss_sold_date_sk#0 == d_date_sk#23)
            :        :     :     :- Scan spark_catalog.default.store_sales [ss_sold_date_sk#0, ss_customer_sk#3, ss_hdemo_sk#5, ss_addr_sk#6, ss_store_sk#7, ss_ticket_number#9, ss_coupon_amt#19, ss_net_profit#22]
            :        :     :     +- Project [d_date_sk#23]
            :        :     :        +- Filter ((d_dow#30 == 1) and (d_year#29 IN (1999, 2000, 2001)))
            :        :     :           +- Scan spark_catalog.default.date_dim [d_date_sk#23, d_year#29, d_dow#30]
            :        :     +- Project [s_store_sk#51, s_city#73]
            :        :        +- Filter ((s_number_employees#57 >= 200) and (s_number_employees#57 <= 295))
            :        :           +- Scan spark_catalog.default.store [s_store_sk#51, s_number_employees#57, s_city#73]
            :        +- Project [hd_demo_sk#80]
