---
source: crates/krishiv-optimizer/tests/it/tpch.rs
expression: optimized.root().to_string()
---
Sort [supp_nation#48 ASC NULLS FIRST, cust_nation#49 ASC NULLS FIRST, l_year#50 ASC NULLS FIRST], true
+- Aggregate [supp_nation#48, cust_nation#49, l_year#50], [supp_nation#48, cust_nation#49, l_year#50, sum(volume#51) AS revenue#52]
   +- Project [n_name#41 AS supp_nation#48, n_name#45 AS cust_nation#49, extract('year', l_shipdate#17) AS l_year#50, (l_extendedprice#12 * (1 - l_discount#13)) AS volume#51]
      +- Join Inner, ((((n_name#41 == 'FRANCE') and (n_name#45 == 'GERMANY')) or ((n_name#41 == 'GERMANY') and (n_name#45 == 'FRANCE'))) and (o_orderkey#23 == l_orderkey#7))
         :- Project [n_name#45, o_orderkey#23]
         :  +- Join Inner, (c_custkey#32 == o_custkey#24)
         :     :- Project [c_custkey#32, n_name#45]
         :     :  +- Join Inner, (c_nationkey#35 == n_nationkey#44)
         :     :     :- Scan spark_catalog.default.customer [c_custkey#32, c_nationkey#35]
         :     :     +- Shift +4
         :     :        +- Filter ((n_name#41 == 'GERMANY') or (n_name#41 == 'FRANCE'))
         :     :           +- Scan spark_catalog.default.nation [n_nationkey#40, n_name#41] (shared #1)
         :     +- Scan spark_catalog.default.orders [o_orderkey#23, o_custkey#24]
         +- Project [l_orderkey#7, l_extendedprice#12, l_discount#13, l_shipdate#17, n_name#41]
            +- Join Inner, (s_nationkey#3 == n_nationkey#40)
               :- Project [s_nationkey#3, l_orderkey#7, l_extendedprice#12, l_discount#13, l_shipdate#17]
               :  +- Join Inner, (s_suppkey#0 == l_suppkey#9)
               :     :- Scan spark_catalog.default.supplier [s_suppkey#0, s_nationkey#3]
               :     +- Filter ((l_shipdate#17 >= DATE '1995-01-01') and (l_shipdate#17 <= DATE '1996-12-31'))
               :        +- Scan spark_catalog.default.lineitem [l_orderkey#7, l_suppkey#9, l_extendedprice#12, l_discount#13, l_shipdate#17]
               +- Filter ((n_name#41 == 'FRANCE') or (n_name#41 == 'GERMANY'))
                  +- Shared #1, printed above
