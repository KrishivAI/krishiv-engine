---
source: crates/krishiv-optimizer/tests/it/join_order.rs
expression: optimized.root().to_string()
---
Limit 20
+- Sort [revenue#37 DESC NULLS LAST], true
   +- Aggregate [c_custkey#0, c_name#1, c_acctbal#5, c_phone#4, n_name#34, c_address#2, c_comment#7], [c_custkey#0, c_name#1, sum((l_extendedprice#22 * (1 - l_discount#23))) AS revenue#37, c_acctbal#5, n_name#34, c_address#2, c_phone#4, c_comment#7]
      +- Project [l_extendedprice#22, l_discount#23, c_custkey#0, c_name#1, c_address#2, c_phone#4, c_acctbal#5, c_comment#7, n_name#34]
         +- Join Inner, (l_orderkey#17 == o_orderkey#8)
            :- Project [l_orderkey#17, l_extendedprice#22, l_discount#23]
            :  +- Filter ((l_returnflag#25 == 'R') and isnotnull(l_orderkey#17))
            :     +- Scan spark_catalog.default.lineitem [l_orderkey#17, l_extendedprice#22, l_discount#23, l_returnflag#25]
            +- Project [o_orderkey#8, c_custkey#0, c_name#1, c_address#2, c_phone#4, c_acctbal#5, c_comment#7, n_name#34]
               +- Join Inner, (c_custkey#0 == o_custkey#9)
                  :- Project [o_orderkey#8, o_custkey#9]
                  :  +- Filter ((((o_orderdate#12 >= DATE '1993-10-01') and (o_orderdate#12 < DATE '1994-01-01')) and isnotnull(o_custkey#9)) and isnotnull(o_orderkey#8))
                  :     +- Scan spark_catalog.default.orders [o_orderkey#8, o_custkey#9, o_orderdate#12]
                  +- Project [c_custkey#0, c_name#1, c_address#2, c_phone#4, c_acctbal#5, c_comment#7, n_name#34]
                     +- Join Inner, (c_nationkey#3 == n_nationkey#33)
                        :- Filter (isnotnull(c_nationkey#3) and isnotnull(c_custkey#0))
                        :  +- Scan spark_catalog.default.customer [c_custkey#0, c_name#1, c_address#2, c_nationkey#3, c_phone#4, c_acctbal#5, c_comment#7]
                        +- Filter isnotnull(n_nationkey#33)
                           +- Scan spark_catalog.default.nation [n_nationkey#33, n_name#34]
