---
source: crates/krishiv-optimizer/tests/it/rules.rs
expression: "SELECT t.a FROM t JOIN (SELECT a, count(*) AS n FROM u WHERE d IN (SELECT b FROM t WHERE c > 0) GROUP BY a) g ON t.a = g.a WHERE t.b = 'x'"
---
Project [a#0]
+- Join Inner, (a#0 == a#3)
   :- Project [a#0]
   :  +- Filter (b#1 == 'x')
   :     +- Scan spark_catalog.default.t [a#0, b#1, c#2] (shared #1)
   +- Aggregate [a#3], [a#3]
      +- Join LeftSemi, (a#3 == a#6)
         :- Project [a#3]
         :  +- Join LeftSemi, (d#4 == b#1)
         :     :- Scan spark_catalog.default.u [a#3, d#4]
         :     +- Project [b#1]
         :        +- Filter (c#2 > 0L)
         :           +- Shared #1, printed above
         +- Shift +6
            +- Project [a#0]
               +- Filter (b#1 == 'x')
                  +- Shared #1, printed above
