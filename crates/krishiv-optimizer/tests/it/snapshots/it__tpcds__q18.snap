---
source: crates/krishiv-optimizer/tests/it/tpcds.rs
expression: optimized.root().to_string()
---
Limit 100
+- Sort [ca_country#142 ASC NULLS FIRST, ca_state#143 ASC NULLS FIRST, ca_county#144 ASC NULLS FIRST, i_item_id#141 ASC NULLS FIRST], true
   +- Aggregate [i_item_id#141, ca_country#142, ca_state#143, ca_county#144, spark_grouping_id#133], [i_item_id#141, ca_country#142, ca_state#143, ca_county#144, avg(state(avg#sum#145, avg#count#146)) AS agg1#134, avg(state(avg#sum#147, avg#count#148)) AS agg2#135, avg(state(avg#sum#149, avg#count#150)) AS agg3#136, avg(state(avg#sum#151, avg#count#152)) AS agg4#137, avg(state(avg#sum#153, avg#count#154)) AS agg5#138, avg(state(avg#sum#155, avg#count#156)) AS agg6#139, avg(state(avg#sum#157, avg#count#158)) AS agg7#140]
      +- Expand [[i_item_id#112, ca_country#80, ca_state#78, ca_county#77, 0L, avg#sum#145, avg#count#146, avg#sum#147, avg#count#148, avg#sum#149, avg#count#150, avg#sum#151, avg#count#152, avg#sum#153, avg#count#154, avg#sum#155, avg#count#156, avg#sum#157, avg#count#158], [i_item_id#112, ca_country#80, ca_state#78, CAST(NULL AS STRING), 1L, avg#sum#145, avg#count#146, avg#sum#147, avg#count#148, avg#sum#149, avg#count#150, avg#sum#151, avg#count#152, avg#sum#153, avg#count#154, avg#sum#155, avg#count#156, avg#sum#157, avg#count#158], [i_item_id#112, ca_country#80, CAST(NULL AS STRING), CAST(NULL AS STRING), 3L, avg#sum#145, avg#count#146, avg#sum#147, avg#count#148, avg#sum#149, avg#count#150, avg#sum#151, avg#count#152, avg#sum#153, avg#count#154, avg#sum#155, avg#count#156, avg#sum#157, avg#count#158], [i_item_id#112, CAST(NULL AS STRING), CAST(NULL AS STRING), CAST(NULL AS STRING), 7L, avg#sum#145, avg#count#146, avg#sum#147, avg#count#148, avg#sum#149, avg#count#150, avg#sum#151, avg#count#152, avg#sum#153, avg#count#154, avg#sum#155, avg#count#156, avg#sum#157, avg#count#158], [CAST(NULL AS STRING), CAST(NULL AS STRING), CAST(NULL AS STRING), CAST(NULL AS STRING), 15L, avg#sum#145, avg#count#146, avg#sum#147, avg#count#148, avg#sum#149, avg#count#150, avg#sum#151, avg#count#152, avg#sum#153, avg#count#154, avg#sum#155, avg#count#156, avg#sum#157, avg#count#158]], [i_item_id#141, ca_country#142, ca_state#143, ca_county#144, spark_grouping_id#133, avg#sum#145, avg#count#146, avg#sum#147, avg#count#148, avg#sum#149, avg#count#150, avg#sum#151, avg#count#152, avg#sum#153, avg#count#154, avg#sum#155, avg#count#156, avg#sum#157, avg#count#158]
         +- PartialAggregate [ca_county#77, ca_state#78, ca_country#80, i_item_id#112], [avg(CAST(cs_quantity#18 AS DECIMAL(12,2))), avg(CAST(cs_list_price#20 AS DECIMAL(12,2))), avg(CAST(cs_coupon_amt#27 AS DECIMAL(12,2))), avg(CAST(cs_sales_price#21 AS DECIMAL(12,2))), avg(CAST(cs_net_profit#33 AS DECIMAL(12,2))), avg(CAST(c_birth_year#65 AS DECIMAL(12,2))), avg(CAST(cd_dep_count#40 AS DECIMAL(12,2)))]
            +- Join Inner, (c_current_addr_sk#56 == ca_address_sk#70)
               :- Filter (isnotnull(ca_address_sk#70) and (ca_state#78 IN ('MS', 'IN', 'ND', 'OK', 'NM', 'VA', 'MS')))
               :  +- Scan spark_catalog.default.customer_address [ca_address_sk#70, ca_county#77, ca_state#78, ca_country#80]
               +- Project [i_item_id#112, c_current_addr_sk#56, c_birth_year#65, cs_quantity#18, cs_list_price#20, cs_sales_price#21, cs_coupon_amt#27, cs_net_profit#33, cd_dep_count#40]
                  +- Join Inner, (cs_item_sk#15 == i_item_sk#111)
                     :- Filter isnotnull(i_item_sk#111)
                     :  +- Scan spark_catalog.default.item [i_item_sk#111, i_item_id#112]
                     +- Project [c_current_addr_sk#56, c_birth_year#65, cs_item_sk#15, cs_quantity#18, cs_list_price#20, cs_sales_price#21, cs_coupon_amt#27, cs_net_profit#33, cd_dep_count#40]
                        +- Join Inner, (c_current_cdemo_sk#54 == cd_demo_sk#43)
                           :- Project [cd_demo_sk#43]
                           :  +- Shift +9
                           :     +- Filter isnotnull(cd_demo_sk#34)
                           :        +- Scan spark_catalog.default.customer_demographics [cd_demo_sk#34, cd_gender#35, cd_education_status#37, cd_dep_count#40] (shared #1)
                           +- Project [c_current_cdemo_sk#54, c_current_addr_sk#56, c_birth_year#65, cs_item_sk#15, cs_quantity#18, cs_list_price#20, cs_sales_price#21, cs_coupon_amt#27, cs_net_profit#33, cd_dep_count#40]
                              +- Join Inner, (cs_bill_customer_sk#3 == c_customer_sk#52)
                                 :- Project [c_customer_sk#52, c_current_cdemo_sk#54, c_current_addr_sk#56, c_birth_year#65]
                                 :  +- Filter (((isnotnull(c_current_addr_sk#56) and isnotnull(c_current_cdemo_sk#54)) and isnotnull(c_customer_sk#52)) and (c_birth_month#64 IN (1, 6, 8, 9, 12, 2)))
                                 :     +- Scan spark_catalog.default.customer [c_customer_sk#52, c_current_cdemo_sk#54, c_current_addr_sk#56, c_birth_month#64, c_birth_year#65]
                                 +- Project [cs_bill_customer_sk#3, cs_item_sk#15, cs_quantity#18, cs_list_price#20, cs_sales_price#21, cs_coupon_amt#27, cs_net_profit#33, cd_dep_count#40]
                                    +- Join Inner, (cs_sold_date_sk#0 == d_date_sk#83)
                                       :- Project [d_date_sk#83]
                                       :  +- Filter (isnotnull(d_date_sk#83) and (d_year#89 == 1998))
                                       :     +- Scan spark_catalog.default.date_dim [d_date_sk#83, d_year#89]
                                       +- Project [cs_sold_date_sk#0, cs_bill_customer_sk#3, cs_item_sk#15, cs_quantity#18, cs_list_price#20, cs_sales_price#21, cs_coupon_amt#27, cs_net_profit#33, cd_dep_count#40]
                                          +- Join Inner, (cs_bill_cdemo_sk#4 == cd_demo_sk#34)
                                             :- Filter (((isnotnull(cs_item_sk#15) and isnotnull(cs_sold_date_sk#0)) and isnotnull(cs_bill_customer_sk#3)) and isnotnull(cs_bill_cdemo_sk#4))
                                             :  +- Scan spark_catalog.default.catalog_sales [cs_sold_date_sk#0, cs_bill_customer_sk#3, cs_bill_cdemo_sk#4, cs_item_sk#15, cs_quantity#18, cs_list_price#20, cs_sales_price#21, cs_coupon_amt#27, cs_net_profit#33]
                                             +- Project [cd_demo_sk#34, cd_dep_count#40]
                                                +- Filter ((isnotnull(cd_demo_sk#34) and (cd_education_status#37 == 'Unknown')) and (cd_gender#35 == 'F'))
                                                   +- Shared #1, printed above
