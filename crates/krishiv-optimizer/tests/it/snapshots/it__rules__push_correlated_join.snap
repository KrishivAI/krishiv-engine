---
source: crates/krishiv-optimizer/tests/it/rules.rs
expression: SELECT t.a FROM t JOIN u ON t.a = u.a WHERE t.c > (SELECT count(*) FROM u u2 WHERE u2.d = t.b AND u2.a = u.a)
---
Project [a#0]
+- Filter (c#2 > CASE WHEN isnull(count(1)#7) THEN 0L ELSE count(1)#7 END)
   +- Join LeftOuter, ((b#1 == d#6) and (a#3 == a#5))
      :- Join Inner, (a#0 == a#3)
      :  :- Scan spark_catalog.default.t [a#0, b#1, c#2]
      :  +- Project [a#3]
      :     +- Scan spark_catalog.default.u [a#3, d#4] (shared #1)
      +- Aggregate [d#6, a#5], [count(1) AS count(1)#7, d#6, a#5]
         +- Shift +2
            +- Shared #1, printed above
