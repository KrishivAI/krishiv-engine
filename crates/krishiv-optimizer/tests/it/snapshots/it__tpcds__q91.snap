---
source: crates/krishiv-optimizer/tests/it/tpcds.rs
expression: optimized.root().to_string()
---
Sort [Returns_Loss#134 DESC NULLS LAST], true
+- Aggregate [cc_call_center_id#1, cc_name#6, cc_manager#11, cd_marital_status#119, cd_education_status#120], [cc_call_center_id#1 AS Call_Center#131, cc_name#6 AS Call_Center_Name#132, cc_manager#11 AS Manager#133, sum(cr_net_loss#57) AS Returns_Loss#134]
   +- Project [cd_marital_status#119, cd_education_status#120, cr_net_loss#57, cc_call_center_id#1, cc_name#6, cc_manager#11]
      +- Join Inner, (cr_returning_customer_sk#38 == c_customer_sk#86)
         :- Project [c_customer_sk#86, cd_marital_status#119, cd_education_status#120]
         :  +- Join Inner, (ca_address_sk#104 == c_current_addr_sk#90)
         :     :- Project [c_customer_sk#86, c_current_addr_sk#90, cd_marital_status#119, cd_education_status#120]
         :     :  +- Join Inner, (hd_demo_sk#126 == c_current_hdemo_sk#89)
         :     :     :- Project [c_customer_sk#86, c_current_hdemo_sk#89, c_current_addr_sk#90, cd_marital_status#119, cd_education_status#120]
         :     :     :  +- Join Inner, (cd_demo_sk#117 == c_current_cdemo_sk#88)
         :     :     :     :- Scan spark_catalog.default.customer [c_customer_sk#86, c_current_cdemo_sk#88, c_current_hdemo_sk#89, c_current_addr_sk#90]
         :     :     :     +- Filter (((cd_marital_status#119 == 'M') and (cd_education_status#120 == 'Unknown')) or ((cd_marital_status#119 == 'W') and (cd_education_status#120 == 'Advanced Degree')))
         :     :     :        +- Scan spark_catalog.default.customer_demographics [cd_demo_sk#117, cd_marital_status#119, cd_education_status#120]
         :     :     +- Project [hd_demo_sk#126]
         :     :        +- Filter (hd_buy_potential#128 like 'Unknown%')
         :     :           +- Scan spark_catalog.default.household_demographics [hd_demo_sk#126, hd_buy_potential#128]
         :     +- Project [ca_address_sk#104]
         :        +- Filter (ca_gmt_offset#115 == -7.00)
         :           +- Scan spark_catalog.default.customer_address [ca_address_sk#104, ca_gmt_offset#115]
         +- Project [cr_returning_customer_sk#38, cr_net_loss#57, cc_call_center_id#1, cc_name#6, cc_manager#11]
            +- Join Inner, (cr_call_center_sk#42 == cc_call_center_sk#0)
               :- Project [cr_returning_customer_sk#38, cr_call_center_sk#42, cr_net_loss#57]
               :  +- Join Inner, (cr_returned_date_sk#31 == d_date_sk#58)
               :     :- Scan spark_catalog.default.catalog_returns [cr_returned_date_sk#31, cr_returning_customer_sk#38, cr_call_center_sk#42, cr_net_loss#57]
               :     +- Project [d_date_sk#58]
               :        +- Filter ((d_year#64 == 1998) and (d_moy#66 == 11))
               :           +- Scan spark_catalog.default.date_dim [d_date_sk#58, d_year#64, d_moy#66]
               +- Scan spark_catalog.default.call_center [cc_call_center_sk#0, cc_call_center_id#1, cc_name#6, cc_manager#11]
