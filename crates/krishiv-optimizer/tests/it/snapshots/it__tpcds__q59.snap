         :- Project [s_store_name#72 AS s_store_name1#124, d_week_seq#58 AS d_week_seq1#125, s_store_id#68 AS s_store_id1#126, sun_sales#60 AS sun_sales1#127, mon_sales#61 AS mon_sales1#128, tue_sales#62 AS tue_sales1#129, wed_sales#63 AS wed_sales1#130, thu_sales#64 AS thu_sales1#131, fri_sales#65 AS fri_sales1#132, sat_sales#66 AS sat_sales1#133]
