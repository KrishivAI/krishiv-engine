Limit 100
+- Sort [s_store_name1#124 ASC NULLS FIRST, s_store_id1#126 ASC NULLS FIRST, d_week_seq1#125 ASC NULLS FIRST], true
   +- Project [s_store_name1#124, s_store_id1#126, d_week_seq1#125, (sun_sales1#127 / sun_sales2#223) AS sun_sales_ratio#230, (mon_sales1#128 / mon_sales2#224) AS mon_sales_ratio#231, (tue_sales1#129 / tue_sales2#225) AS tue_sales_ratio#232, (wed_sales1#130 / wed_sales2#226) AS wed_sales_ratio#233, (thu_sales1#131 / thu_sales2#227) AS thu_sales_ratio#234, (fri_sales1#132 / fri_sales2#228) AS fri_sales_ratio#235, (sat_sales1#133 / sat_sales2#229) AS sat_sales_ratio#236]
