---
source: crates/krishiv-optimizer/tests/it/tpcds.rs
expression: optimized.root().to_string()
---
Limit 100
+- Sort [am_pm_ratio#130 ASC NULLS FIRST], true
   +- Project [CASE WHEN (pmc#129 == 0L) THEN CAST(NULL AS DECIMAL(35,20)) ELSE (CAST(amc#63 AS DECIMAL(15,4)) / CAST(pmc#129 AS DECIMAL(15,4))) END AS am_pm_ratio#130]
      +- Join Inner
         :- Aggregate [], [count(1) AS amc#63]
         :  +- Project [ws_ship_hdemo_sk#10]
         :     +- Join Inner, (ws_ship_hdemo_sk#10 == hd_demo_sk#34)
         :        :- Project [ws_ship_hdemo_sk#10]
         :        :  +- Join Inner, (ws_sold_time_sk#1 == t_time_sk#39)
         :        :     :- Project [ws_sold_time_sk#1, ws_ship_hdemo_sk#10]
         :        :     :  +- Join Inner, (ws_web_page_sk#12 == wp_web_page_sk#49)
         :        :     :     :- Scan spark_catalog.default.web_sales [ws_sold_time_sk#1, ws_ship_hdemo_sk#10, ws_web_page_sk#12] (shared #1)
         :        :     :     +- Project [wp_web_page_sk#49]
         :        :     :        +- Filter ((wp_char_count#59 >= 5000) and (wp_char_count#59 <= 5200))
         :        :     :           +- Scan spark_catalog.default.web_page [wp_web_page_sk#49, wp_char_count#59] (shared #2)
         :        :     +- Project [t_time_sk#39]
         :        :        +- Filter ((t_hour#42 >= 8) and (t_hour#42 <= 9))
         :        :           +- Scan spark_catalog.default.time_dim [t_time_sk#39, t_hour#42] (shared #3)
         :        +- Project [hd_demo_sk#34]
         :           +- Filter (hd_dep_count#37 == 6)
         :              +- Scan spark_catalog.default.household_demographics [hd_demo_sk#34, hd_dep_count#37] (shared #4)
         +- Shift +65
            +- Aggregate [], [count(1) AS pmc#64]
               +- Project [ws_ship_hdemo_sk#10]
                  +- Join Inner, (ws_ship_hdemo_sk#10 == hd_demo_sk#34)
                     :- Project [ws_ship_hdemo_sk#10]
                     :  +- Join Inner, (ws_sold_time_sk#1 == t_time_sk#39)
                     :     :- Project [ws_sold_time_sk#1, ws_ship_hdemo_sk#10]
                     :     :  +- Join Inner, (ws_web_page_sk#12 == wp_web_page_sk#49)
                     :     :     :- Shared #1, printed above
                     :     :     +- Project [wp_web_page_sk#49]
                     :     :        +- Filter ((wp_char_count#59 >= 5000) and (wp_char_count#59 <= 5200))
                     :     :           +- Shared #2, printed above
                     :     +- Project [t_time_sk#39]
                     :        +- Filter ((t_hour#42 >= 19) and (t_hour#42 <= 20))
                     :           +- Shared #3, printed above
                     +- Project [hd_demo_sk#34]
                        +- Filter (hd_dep_count#37 == 6)
                           +- Shared #4, printed above
