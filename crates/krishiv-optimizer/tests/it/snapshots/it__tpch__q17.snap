      :           +- Scan spark_catalog.default.part [p_partkey#16, p_brand#19, p_container#22] (shared #2)
      +- Aggregate [l_partkey#26], [(0.2 * avg(l_quantity#29)) AS (0.2 * avg(l_quantity))#41, l_partkey#26]
         +- Join LeftSemi, (l_partkey#26 == p_partkey#59)
            :- Project [l_partkey#26, l_quantity#29]
            :  +- Shift +25
