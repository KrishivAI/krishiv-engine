+- Project [l_extendedprice#5]
   +- Join Inner, ((p_partkey#16 == l_partkey#26) and (CAST(l_quantity#4 AS DECIMAL(21,7)) < (0.2 * avg(l_quantity))#41))
      :- Project [l_quantity#4, l_extendedprice#5, p_partkey#16]
