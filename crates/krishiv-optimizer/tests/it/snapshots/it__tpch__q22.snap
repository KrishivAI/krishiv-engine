Sort [cntrycode#26 ASC NULLS FIRST], true
+- Aggregate [cntrycode#26], [cntrycode#26, count(1) AS numcust#27, sum(c_acctbal#5) AS totacctbal#28]
   +- Project [substring(c_phone#4, 1, 2) AS cntrycode#26, c_acctbal#5]
      +- Filter (((substring(c_phone#4, 1, 2) IN ('13', '31', '23', '29', '30', '18', '17')) and (c_acctbal#5 > scalar-subquery)) and (NOT exists))
         :  :- Aggregate [], [avg(c_acctbal#13) AS avg(c_acctbal)#16]
         :  :  +- Project [c_acctbal#13]
         :  :     +- Shift +8
         :  :        +- Filter ((c_acctbal#5 > 0.00) and (substring(c_phone#4, 1, 2) IN ('13', '31', '23', '29', '30', '18', '17')))
         :  :           +- Scan spark_catalog.default.customer [c_custkey#0, c_phone#4, c_acctbal#5] (shared #1)
         :  +- Filter (o_custkey#18 == outer(c_custkey#0))
         :     +- Scan spark_catalog.default.orders [o_custkey#18]
         +- Shared #1, printed above
