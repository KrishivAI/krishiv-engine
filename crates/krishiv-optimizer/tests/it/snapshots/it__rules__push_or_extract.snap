---
source: crates/krishiv-optimizer/tests/it/rules.rs
expression: "SELECT t.a FROM t JOIN u ON t.a = u.a WHERE (t.b = 'x' AND u.d = 'y') OR (t.b = 'z' AND u.d = 'w')"
---
Project [a#0]
+- Join Inner, ((a#0 == a#3) and (((b#1 == 'x') and (d#4 == 'y')) or ((b#1 == 'z') and (d#4 == 'w'))))
   :- Filter ((b#1 == 'x') or (b#1 == 'z'))
   :  +- Scan spark_catalog.default.t [a#0, b#1]
   +- Filter ((d#4 == 'y') or (d#4 == 'w'))
      +- Scan spark_catalog.default.u [a#3, d#4]
