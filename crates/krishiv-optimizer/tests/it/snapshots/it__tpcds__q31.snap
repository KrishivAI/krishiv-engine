      +- Join Inner, ((CASE WHEN (web_sales#160 > 0.00) THEN ((web_sales#164 * 1.0000) / web_sales#160) ELSE CAST(NULL AS DECIMAL(38,19)) END > CASE WHEN (store_sales#148 > 0.00) THEN ((store_sales#152 * 1.0000) / store_sales#148) ELSE CAST(NULL AS DECIMAL(38,19)) END) and (ca_county#145 == ca_county#149))
