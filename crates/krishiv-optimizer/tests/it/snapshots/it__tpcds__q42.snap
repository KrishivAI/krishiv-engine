Limit 100
+- Sort [sum(ss_ext_sales_price)#73 DESC NULLS LAST, d_year#6 ASC NULLS FIRST, i_category_id#62 ASC NULLS FIRST, i_category#63 ASC NULLS FIRST], true
   +- Aggregate [d_year#6, i_category_id#62, i_category#63], [d_year#6, i_category_id#62, i_category#63, sum(ss_ext_sales_price#43) AS sum(ss_ext_sales_price)#73]
      +- Project [i_category_id#62, i_category#63, ss_ext_sales_price#43, d_year#6]
         +- Join Inner, (ss_item_sk#30 == i_item_sk#51)
            :- Project [i_item_sk#51, i_category_id#62, i_category#63]
            :  +- Filter (i_manager_id#71 == 1)
            :     +- Scan spark_catalog.default.item [i_item_sk#51, i_category_id#62, i_category#63, i_manager_id#71]
            +- Project [ss_item_sk#30, ss_ext_sales_price#43, d_year#6]
               +- Join Inner, (d_date_sk#0 == ss_sold_date_sk#28)
                  :- Scan spark_catalog.default.store_sales [ss_sold_date_sk#28, ss_item_sk#30, ss_ext_sales_price#43]
                  +- Project [d_date_sk#0, d_year#6]
                     +- Filter ((d_moy#8 == 11) and (d_year#6 == 2000))
                        +- Scan spark_catalog.default.date_dim [d_date_sk#0, d_year#6, d_moy#8]
