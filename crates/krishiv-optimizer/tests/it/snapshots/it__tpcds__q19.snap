---
source: crates/krishiv-optimizer/tests/it/tpcds.rs
expression: optimized.root().to_string()
---
Limit 100
+- Sort [ext_price#135 DESC NULLS LAST, brand#134 ASC NULLS FIRST, brand_id#133 ASC NULLS FIRST, i_manufact_id#64 ASC NULLS FIRST, i_manufact#65 ASC NULLS FIRST], true
   +- Aggregate [i_brand#59, i_brand_id#58, i_manufact_id#64, i_manufact#65], [i_brand_id#58 AS brand_id#133, i_brand#59 AS brand#134, i_manufact_id#64, i_manufact#65, sum(ss_ext_sales_price#43) AS ext_price#135]
      +- Project [i_brand_id#58, i_brand#59, i_manufact_id#64, i_manufact#65, ss_ext_sales_price#43]
         +- Join Inner, ((NOT (substring(ca_zip#100, 1, 5) == substring(s_zip#129, 1, 5))) and (c_current_addr_sk#77 == ca_address_sk#91))
            :- Scan spark_catalog.default.customer_address [ca_address_sk#91, ca_zip#100]
            +- Project [c_current_addr_sk#77, s_zip#129, i_brand_id#58, i_brand#59, i_manufact_id#64, i_manufact#65, ss_ext_sales_price#43]
               +- Join Inner, (ss_customer_sk#31 == c_customer_sk#73)
                  :- Scan spark_catalog.default.customer [c_customer_sk#73, c_current_addr_sk#77]
                  +- Project [s_zip#129, i_brand_id#58, i_brand#59, i_manufact_id#64, i_manufact#65, ss_customer_sk#31, ss_ext_sales_price#43]
                     +- Join Inner, (ss_store_sk#35 == s_store_sk#104)
                        :- Scan spark_catalog.default.store [s_store_sk#104, s_zip#129]
                        +- Project [i_brand_id#58, i_brand#59, i_manufact_id#64, i_manufact#65, ss_customer_sk#31, ss_store_sk#35, ss_ext_sales_price#43]
                           +- Join Inner, (ss_item_sk#30 == i_item_sk#51)
                              :- Project [i_item_sk#51, i_brand_id#58, i_brand#59, i_manufact_id#64, i_manufact#65]
                              :  +- Filter (i_manager_id#71 == 8)
                              :     +- Scan spark_catalog.default.item [i_item_sk#51, i_brand_id#58, i_brand#59, i_manufact_id#64, i_manufact#65, i_manager_id#71]
                              +- Project [ss_item_sk#30, ss_customer_sk#31, ss_store_sk#35, ss_ext_sales_price#43]
                                 +- Join Inner, (d_date_sk#0 == ss_sold_date_sk#28)
                                    :- Scan spark_catalog.default.store_sales [ss_sold_date_sk#28, ss_item_sk#30, ss_customer_sk#31, ss_store_sk#35, ss_ext_sales_price#43]
                                    +- Project [d_date_sk#0]
                                       +- Filter ((d_moy#8 == 11) and (d_year#6 == 1998))
                                          +- Scan spark_catalog.default.date_dim [d_date_sk#0, d_year#6, d_moy#8]
