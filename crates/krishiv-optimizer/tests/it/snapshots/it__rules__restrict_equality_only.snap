---
source: crates/krishiv-optimizer/tests/it/rules.rs
expression: "SELECT t.a FROM t JOIN (SELECT a, count(*) AS n FROM u GROUP BY a) g ON t.a = g.a AND t.c > g.n WHERE t.b = 'x'"
---
Project [a#0]
+- Join Inner, ((a#0 == a#3) and (c#2 > n#5))
   :- Project [a#0, c#2]
   :  +- Filter (b#1 == 'x')
   :     +- Scan spark_catalog.default.t [a#0, b#1, c#2] (shared #1)
   +- Aggregate [a#3], [a#3, count(1) AS n#5]
      +- Join LeftSemi, (a#3 == a#6)
         :- Scan spark_catalog.default.u [a#3]
         +- Shift +6
            +- Project [a#0]
               +- Filter (b#1 == 'x')
                  +- Shared #1, printed above
