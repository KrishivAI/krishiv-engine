---
source: crates/krishiv-exec/tests/planner/tpch.rs
expression: tpch.plan(q).to_string()
---
Sort [nation#50 ASC NULLS FIRST, o_year#51 DESC NULLS LAST]
+- Project [nation#50, o_year#51, sum(amount#52)#4611686018427387911 AS sum_profit#53]
   +- HashAggregate keys=[nation#50, o_year#51], functions=[sum(amount#52)]
      +- Project [n_name#47 AS nation#50, extract('year', o_orderdate#41) AS o_year#51, ((l_extendedprice#21 * (1 - l_discount#22)) - (ps_supplycost#35 * l_quantity#20)) AS amount#52]
         +- HashJoin Inner, [ps_suppkey#33, ps_partkey#32] = [l_suppkey#18, l_partkey#17]
            :- Scan spark_catalog.default.partsupp [ps_partkey#32, ps_suppkey#33, ps_supplycost#35]
            +- Project [o_orderdate#41, l_partkey#17, l_suppkey#18, l_quantity#20, l_extendedprice#21, l_discount#22, n_name#47]
               +- HashJoin Inner, [l_suppkey#18] = [s_suppkey#9]
                  :- Project [o_orderdate#41, l_partkey#17, l_suppkey#18, l_quantity#20, l_extendedprice#21, l_discount#22]
                  :  +- HashJoin Inner, [o_orderkey#37] = [l_orderkey#16]
                  :     :- Scan spark_catalog.default.orders [o_orderkey#37, o_orderdate#41]
                  :     +- Project [l_orderkey#16, l_partkey#17, l_suppkey#18, l_quantity#20, l_extendedprice#21, l_discount#22]
                  :        +- HashJoin Inner, [l_partkey#17] = [p_partkey#0]
                  :           :- Scan spark_catalog.default.lineitem [l_orderkey#16, l_partkey#17, l_suppkey#18, l_quantity#20, l_extendedprice#21, l_discount#22]
                  :           +- Project [p_partkey#0]
                  :              +- Filter (p_name#1 like '%green%')
                  :                 +- Scan spark_catalog.default.part [p_partkey#0, p_name#1], PushedFilters: [(p_name#1 like '%green%')]
                  +- Project [s_suppkey#9, n_name#47]
                     +- HashJoin Inner, [s_nationkey#12] = [n_nationkey#46]
                        :- Scan spark_catalog.default.supplier [s_suppkey#9, s_nationkey#12]
                        +- Scan spark_catalog.default.nation [n_nationkey#46, n_name#47]
