---
source: crates/krishiv-exec/tests/planner/tpch.rs
expression: tpch.plan(q).to_string()
---
Sort [nation#50 ASC NULLS FIRST, o_year#51 DESC NULLS LAST]
+- Exchange rangepartitioning(nation#50 ASC NULLS FIRST, o_year#51 DESC NULLS LAST)
   +- Project [nation#50, o_year#51, sum(amount#52)#4611686018427387937 AS sum_profit#53]
      +- HashAggregate keys=[nation#50, o_year#51], functions=[sum(amount#52)]
         +- Exchange hashpartitioning(nation#50, o_year#51)
            +- PartialHashAggregate keys=[nation#50, o_year#51], functions=[sum(amount#52)]
               +- Project [n_name#47 AS nation#50, extract('year', o_orderdate#41) AS o_year#51, ((l_extendedprice#21 * (1 - l_discount#22)) - (ps_supplycost#35 * l_quantity#20)) AS amount#52]
                  +- HashJoin Inner, [o_orderkey#37] = [l_orderkey#16], RuntimeFilter #6: o_orderkey#37 -> spark_catalog.default.orders.o_orderkey, probe filter: isnotnull(o_orderkey#37)
                     :- Scan spark_catalog.default.orders [o_orderkey#37, o_orderdate#41], PushedFilters: [isnotnull(o_orderkey#37)]
                     +- BroadcastExchange
                        +- Project [l_orderkey#16, l_quantity#20, l_extendedprice#21, l_discount#22, ps_supplycost#35, n_name#47]
                           +- HashJoin Inner, [l_suppkey#18, l_partkey#17] = [ps_suppkey#33, ps_partkey#32], RuntimeFilter #4: l_suppkey#18 -> spark_catalog.default.lineitem.l_suppkey, RuntimeFilter #5: l_partkey#17 -> spark_catalog.default.lineitem.l_partkey, probe filter: ((isnotnull(l_partkey#17) and isnotnull(l_suppkey#18)) and isnotnull(l_orderkey#16))
                              :- Scan spark_catalog.default.lineitem [l_orderkey#16, l_partkey#17, l_suppkey#18, l_quantity#20, l_extendedprice#21, l_discount#22], PushedFilters: [((isnotnull(l_partkey#17) and isnotnull(l_suppkey#18)) and isnotnull(l_orderkey#16))]
                              +- BroadcastExchange
                                 +- Project [ps_partkey#32, ps_suppkey#33, ps_supplycost#35, n_name#47]
                                    +- HashJoin Inner, [ps_suppkey#33] = [s_suppkey#9], RuntimeFilter #3: ps_suppkey#33 -> spark_catalog.default.partsupp.ps_suppkey
                                       :- Project [ps_partkey#32, ps_suppkey#33, ps_supplycost#35]
                                       :  +- HashJoin Inner, [ps_partkey#32] = [p_partkey#0], RuntimeFilter #1: ps_partkey#32 -> spark_catalog.default.partsupp.ps_partkey, probe filter: (isnotnull(ps_partkey#32) and isnotnull(ps_suppkey#33))
                                       :     :- Scan spark_catalog.default.partsupp [ps_partkey#32, ps_suppkey#33, ps_supplycost#35], PushedFilters: [(isnotnull(ps_partkey#32) and isnotnull(ps_suppkey#33))]
                                       :     +- BroadcastExchange
                                       :        +- Project [p_partkey#0]
                                       :           +- Filter ((p_name#1 like '%green%') and isnotnull(p_partkey#0))
                                       :              +- Scan spark_catalog.default.part [p_partkey#0, p_name#1], PushedFilters: [((p_name#1 like '%green%') and isnotnull(p_partkey#0))]
                                       +- BroadcastExchange
                                          +- Project [s_suppkey#9, n_name#47]
                                             +- HashJoin Inner, [s_nationkey#12] = [n_nationkey#46], RuntimeFilter #2: s_nationkey#12 -> spark_catalog.default.supplier.s_nationkey, probe filter: (isnotnull(s_suppkey#9) and isnotnull(s_nationkey#12))
                                                :- Scan spark_catalog.default.supplier [s_suppkey#9, s_nationkey#12], PushedFilters: [(isnotnull(s_suppkey#9) and isnotnull(s_nationkey#12))]
                                                +- BroadcastExchange
                                                   +- Filter isnotnull(n_nationkey#46)
                                                      +- Scan spark_catalog.default.nation [n_nationkey#46, n_name#47], PushedFilters: [isnotnull(n_nationkey#46)]
