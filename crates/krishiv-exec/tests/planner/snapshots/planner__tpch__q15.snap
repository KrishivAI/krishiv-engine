                              +- Project revenue [supplier_no#25, total_revenue#26] (ids +2)
                                 +- HashAggregate keys=[l_suppkey#2], functions=[sum((l_extendedprice#5 * (1 - l_discount#6)))]
                                    +- Exchange hashpartitioning(l_suppkey#2)
                                       +- Project [l_suppkey#2, (l_extendedprice#5 * (1 - l_discount#6))]
                                          +- Project [l_suppkey#2, l_extendedprice#5, l_discount#6]
                                             +- Filter ((l_shipdate#10 >= DATE '1996-01-01') and (l_shipdate#10 < DATE '1996-04-01'))
                                                +- Scan spark_catalog.default.lineitem [l_suppkey#2, l_extendedprice#5, l_discount#6, l_shipdate#10], PushedFilters: [((l_shipdate#10 >= DATE '1996-01-01') and (l_shipdate#10 < DATE '1996-04-01'))]
