Sort [revenue#47 DESC NULLS LAST]
+- Project [n_name#41, sum((l_extendedprice#22 * (1 - l_discount#23)))#4611686018427387911 AS revenue#47]
   +- HashAggregate keys=[n_name#41], functions=[sum((l_extendedprice#22 * (1 - l_discount#23)))]
      +- Project [n_name#41, (l_extendedprice#22 * (1 - l_discount#23))]
         +- Project [l_extendedprice#22, l_discount#23, n_name#41]
            +- HashJoin Inner, [l_suppkey#19, l_orderkey#17] = [s_suppkey#33, o_orderkey#8], RuntimeFilter #5: l_suppkey#19 -> spark_catalog.default.lineitem.l_suppkey, RuntimeFilter #6: l_orderkey#17 -> spark_catalog.default.lineitem.l_orderkey
               :- Scan spark_catalog.default.lineitem [l_orderkey#17, l_suppkey#19, l_extendedprice#22, l_discount#23]
               +- Project [o_orderkey#8, s_suppkey#33, n_name#41]
                  +- HashJoin Inner, [o_custkey#9] = [c_custkey#0], RuntimeFilter #4: o_custkey#9 -> spark_catalog.default.orders.o_custkey
                     :- Project [o_orderkey#8, o_custkey#9]
                     :  +- Filter ((o_orderdate#12 >= DATE '1994-01-01') and (o_orderdate#12 < DATE '1995-01-01'))
                     :     +- Scan spark_catalog.default.orders [o_orderkey#8, o_custkey#9, o_orderdate#12], PushedFilters: [((o_orderdate#12 >= DATE '1994-01-01') and (o_orderdate#12 < DATE '1995-01-01'))]
                     +- Project [c_custkey#0, s_suppkey#33, n_name#41]
                        +- HashJoin Inner, [c_nationkey#3] = [s_nationkey#36], RuntimeFilter #3: c_nationkey#3 -> spark_catalog.default.customer.c_nationkey
                           :- Scan spark_catalog.default.customer [c_custkey#0, c_nationkey#3]
                           +- Project [s_suppkey#33, s_nationkey#36, n_name#41]
                              +- HashJoin Inner, [s_nationkey#36] = [n_nationkey#40], RuntimeFilter #2: s_nationkey#36 -> spark_catalog.default.supplier.s_nationkey
                                 :- Scan spark_catalog.default.supplier [s_suppkey#33, s_nationkey#36]
                                 +- Project [n_nationkey#40, n_name#41]
                                    +- HashJoin Inner, [n_regionkey#42] = [r_regionkey#44], RuntimeFilter #1: n_regionkey#42 -> spark_catalog.default.nation.n_regionkey
                                       :- Scan spark_catalog.default.nation [n_nationkey#40, n_name#41, n_regionkey#42]
                                       +- Project [r_regionkey#44]
                                          +- Filter (r_name#45 == 'ASIA')
                                             +- Scan spark_catalog.default.region [r_regionkey#44, r_name#45], PushedFilters: [(r_name#45 == 'ASIA')]
