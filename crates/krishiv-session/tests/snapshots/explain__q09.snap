               :  :- Join Inner
               :  :  :- Join Inner
               :  :  :  :- Join Inner
               :  :  :  :  :- Read part
               :  :  :  :  +- Read supplier
               :  :  :  +- Read lineitem
               :  :  +- Read partsupp
               :  +- Read orders
               +- Read nation

