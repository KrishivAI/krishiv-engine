Limit 20
+- Sort [revenue DESC NULLS LAST], true
   +- Aggregate [c_custkey, c_name, c_acctbal, c_phone, n_name, c_address, c_comment], [c_custkey, c_name, sum((l_extendedprice * (1 - l_discount))) AS revenue, c_acctbal, n_name, c_address, c_phone, c_comment]
      +- Filter ((((c_custkey == o_custkey) and (l_orderkey == o_orderkey)) and (o_orderdate >= CAST('1993-10-01' AS DATE))) and (((o_orderdate < CAST('1994-01-01' AS DATE)) and (l_returnflag == 'R')) and (c_nationkey == n_nationkey)))
         +- Join Inner
            :- Join Inner
            :  :- Join Inner
            :  :  :- Read customer
            :  :  +- Read orders
            :  +- Read lineitem
            +- Read nation
