+- Sort [revenue DESC NULLS LAST, o_orderdate ASC NULLS FIRST], true
   +- Aggregate [l_orderkey, o_orderdate, o_shippriority], [l_orderkey, sum((l_extendedprice * (1 - l_discount))) AS revenue, o_orderdate, o_shippriority]
