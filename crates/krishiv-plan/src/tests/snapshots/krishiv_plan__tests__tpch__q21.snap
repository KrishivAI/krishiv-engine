---
source: crates/krishiv-plan/src/tests/tpch.rs
expression: plan.to_string()
---
Limit 100
+- Sort [numwait DESC NULLS LAST, s_name ASC NULLS FIRST], true
   +- Aggregate [s_name], [s_name, count(*) AS numwait]
      +- Filter ((((s_suppkey == l1.l_suppkey) and (o_orderkey == l1.l_orderkey)) and ((o_orderstatus == 'F') and (l1.l_receiptdate > l1.l_commitdate))) and ((exists and (NOT exists)) and ((s_nationkey == n_nationkey) and (n_name == 'SAUDI ARABIA'))))
         :  :- Project [*]
         :  :  +- Filter ((l2.l_orderkey == l1.l_orderkey) and (NOT (l2.l_suppkey == l1.l_suppkey)))
         :  :     +- SubqueryAlias l2
         :  :        +- Read lineitem
         :  +- Project [*]
         :     +- Filter (((l3.l_orderkey == l1.l_orderkey) and (NOT (l3.l_suppkey == l1.l_suppkey))) and (l3.l_receiptdate > l3.l_commitdate))
         :        +- SubqueryAlias l3
         :           +- Read lineitem
         +- Join Inner
            :- Join Inner
            :  :- Join Inner
            :  :  :- Read supplier
            :  :  +- SubqueryAlias l1
            :  :     +- Read lineitem
            :  +- Read orders
            +- Read nation
