---
source: crates/krishiv-connect/tests/goldens.rs
---
Limit 5
+- Sort [s DESC NULLS LAST], true
   +- Aggregate [x], [x, sum(a) AS s]
      +- WithColumns [x = (b * 2)]
         +- Filter (a > 1)
            +- Read parquet [/data/t.parquet]
-- plan ids --
Limit plan_id=5
  Sort plan_id=4
    Aggregate plan_id=3
      WithColumns plan_id=2
        Filter plan_id=1
          Read plan_id=0
