---
source: crates/krishiv-sql/tests/analyzer.rs
expression: a.plan.root().to_string()
---
Sort [cntrycode#26 ASC NULLS FIRST], true
+- Aggregate [cntrycode#26], [cntrycode#26, count(1) AS numcust#27, sum(c_acctbal#5) AS totacctbal#28]
   +- SubqueryAlias custsale
      +- Project [substring(c_phone#4, 1, 2) AS cntrycode#26, c_acctbal#5]
         +- Filter (((substring(c_phone#4, 1, 2) IN ('13', '31', '23', '29', '30', '18', '17')) and (CAST(c_acctbal#5 AS DECIMAL(19,6)) > scalar-subquery)) and (NOT exists))
            :  :- Aggregate [], [avg(c_acctbal#13) AS avg(c_acctbal)#16]
            :  :  +- Filter ((c_acctbal#13 > CAST(0.00 AS DECIMAL(15,2))) and (substring(c_phone#12, 1, 2) IN ('13', '31', '23', '29', '30', '18', '17')))
            :  :     +- Shift +8
            :  :        +- Scan spark_catalog.default.customer [c_custkey#0, c_name#1, c_address#2, c_nationkey#3, c_phone#4, c_acctbal#5, c_mktsegment#6, c_comment#7] (shared #1)
            :  +- Project [o_orderkey#17, o_custkey#18, o_orderstatus#19, o_totalprice#20, o_orderdate#21, o_orderpriority#22, o_clerk#23, o_shippriority#24, o_comment#25]
            :     +- Filter (o_custkey#18 == outer(c_custkey#0))
            :        +- Scan spark_catalog.default.orders [o_orderkey#17, o_custkey#18, o_orderstatus#19, o_totalprice#20, o_orderdate#21, o_orderpriority#22, o_clerk#23, o_shippriority#24, o_comment#25]
            +- Shared #1, printed above
