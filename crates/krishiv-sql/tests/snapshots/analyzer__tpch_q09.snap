---
Sort [nation#50 ASC NULLS FIRST, o_year#51 DESC NULLS LAST], true
+- Aggregate [nation#50, o_year#51], [nation#50, o_year#51, sum(amount#52) AS sum_profit#53]
   +- SubqueryAlias profit
      +- Project [n_name#47 AS nation#50, extract('year', o_orderdate#41) AS o_year#51, ((l_extendedprice#21 * (1 - l_discount#22)) - (ps_supplycost#35 * l_quantity#20)) AS amount#52]
         +- Filter ((((s_suppkey#9 == l_suppkey#18) and (ps_suppkey#33 == l_suppkey#18)) and ((ps_partkey#32 == l_partkey#17) and (p_partkey#0 == l_partkey#17))) and (((o_orderkey#37 == l_orderkey#16) and (s_nationkey#12 == n_nationkey#46)) and (p_name#1 like '%green%')))
            +- Join Inner
               :- Join Inner
               :  :- Join Inner
               :  :  :- Join Inner
               :  :  :  :- Join Inner
               :  :  :  :  :- Scan spark_catalog.default.part [p_partkey#0, p_name#1, p_mfgr#2, p_brand#3, p_type#4, p_size#5, p_container#6, p_retailprice#7, p_comment#8]
               :  :  :  :  +- Scan spark_catalog.default.supplier [s_suppkey#9, s_name#10, s_address#11, s_nationkey#12, s_phone#13, s_acctbal#14, s_comment#15]
               :  :  :  +- Scan spark_catalog.default.lineitem [l_orderkey#16, l_partkey#17, l_suppkey#18, l_linenumber#19, l_quantity#20, l_extendedprice#21, l_discount#22, l_tax#23, l_returnflag#24, l_linestatus#25, l_shipdate#26, l_commitdate#27, l_receiptdate#28, l_shipinstruct#29, l_shipmode#30, l_comment#31]
               :  :  +- Scan spark_catalog.default.partsupp [ps_partkey#32, ps_suppkey#33, ps_availqty#34, ps_supplycost#35, ps_comment#36]
               :  +- Scan spark_catalog.default.orders [o_orderkey#37, o_custkey#38, o_orderstatus#39, o_totalprice#40, o_orderdate#41, o_orderpriority#42, o_clerk#43, o_shippriority#44, o_comment#45]
               +- Scan spark_catalog.default.nation [n_nationkey#46, n_name#47, n_regionkey#48, n_comment#49]
