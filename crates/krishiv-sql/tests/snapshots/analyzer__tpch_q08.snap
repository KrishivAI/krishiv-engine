+- Aggregate [o_year#60], [o_year#60, (sum(CASE WHEN (nation#62 == 'BRAZIL') THEN volume#61 ELSE CAST(0 AS DECIMAL(32,4)) END) / sum(volume#61)) AS mkt_share#63]
