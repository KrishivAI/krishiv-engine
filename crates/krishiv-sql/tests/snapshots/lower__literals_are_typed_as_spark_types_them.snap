  => [DECIMAL_PRECISION_EXCEEDS_MAX_PRECISION] Decimal precision 39 exceeds max precision 38. SQLSTATE: 22003 @ 7..46
SELECT DATE '2021-02-29' FROM t
  => [INVALID_TYPED_LITERAL] The value of the typed literal "DATE" is invalid: '2021-02-29'. SQLSTATE: 42604 @ 7..24
SELECT DATE '2021-13-01' FROM t
  => [INVALID_TYPED_LITERAL] The value of the typed literal "DATE" is invalid: '2021-13-01'. SQLSTATE: 42604 @ 7..24
SELECT X'zz' FROM t
  => [INVALID_TYPED_LITERAL] The value of the typed literal "X" is invalid: 'zz'. SQLSTATE: 42604 @ 7..12
