---
source: crates/krishiv-sql/tests/lower.rs
expression: "report(&[\"SELECT 1\", \"SELECT DISTINCT a FROM t\",\n\"SELECT /*+ BROADCAST(t) */ a FROM t\",\n\"SELECT a FROM t UNION SELECT a FROM u\", \"VALUES (1)\",\n\"SELECT * FROM VALUES (1) AS v(a)\", \"SELECT * FROM range(3)\",\n\"SELECT a FROM t LATERAL VIEW explode(b) x AS y\",\n\"SELECT row_number() OVER (ORDER BY a) FROM t\",\n\"SELECT a FROM t GROUP BY ROLLUP (a)\", \"SELECT a FROM t GROUP BY a WITH CUBE\",\n\"SELECT * FROM t NATURAL JOIN u\", \"SELECT * FROM t, LATERAL (SELECT a)\",\n\"SELECT * FROM t VERSION AS OF 1\", \"SELECT a FROM t CLUSTER BY a\",\n\"SELECT a FROM t DISTRIBUTE BY a\", \"SELECT a FROM t LIMIT 1 OFFSET 2\",\n\"FROM t SELECT a LIMIT 1 OFFSET 2\", \"FROM t SELECT a CLUSTER BY a\",\n\"FROM t SELECT a DISTRIBUTE BY a\", \"FROM t SELECT a WINDOW w AS (ORDER BY a)\",\n\"SELECT a FROM t WINDOW w AS (ORDER BY a)\", \"SELECT a FROM t QUALIFY a > 1\",\n\"WITH RECURSIVE r AS (SELECT a FROM t) SELECT * FROM r\",\n\"SELECT * EXCEPT (a) FROM t\", \"SELECT a FROM t INTERSECT SELECT a FROM u\",\n\"SELECT a FROM t EXCEPT ALL SELECT a FROM u\",\n\"SELECT /*+ BROADCAST(t), MERGE(u) */ /*+ COALESCE(2) */ DISTINCT a FROM t, u\",\n\"SELECT a FROM t UNION ALL SELECT b FROM u UNION SELECT c FROM v\",\n\"SELECT x[0] FROM t\", \"SELECT (a).b.c FROM t\", \"SELECT f(a).b FROM t\",\n\"SELECT transform(a, x -> x) FROM t\", \"SELECT (a, b) FROM t\",\n\"SELECT a LIKE ANY ('x', 'y') FROM t\", \"SELECT ? FROM t\",\n\"SELECT INTERVAL 1 DAY FROM t\",\n\"SELECT TIMESTAMP '2020-01-01 00:00:00' FROM t\", \"SELECT db.f(a) FROM t\",\n\"SELECT f(x => 1) FROM t\",\n\"SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY a) FROM t\",\n\"SELECT sum(a) IGNORE NULLS FROM t\", \"SELECT * FROM t WITH (k = x)\",\n\"FROM t SELECT a SELECT b\",\n\"SELECT * FROM parquet.`s3a://k:Canary-7f3a9c@b/p` WITH ('password' = 'Canary-7f3a9c')\",\n\"WITH c (x) AS (SELECT a FROM t) SELECT x FROM c ORDER BY x LIMIT ALL\",\n\"FROM t SELECT a SORT BY a\",\n\"SELECT a FROM t WHERE (a, b) IN (SELECT a, d FROM u) AND a NOT BETWEEN 1 AND 2\",\n\"SELECT a <=> 1, a IS DISTINCT FROM 1, a IS NOT DISTINCT FROM 1, a IS TRUE, a IS NOT FALSE, a IS UNKNOWN, a IS NOT UNKNOWN FROM t\",\n\"SELECT +a, ~a, a DIV 2, a & 1, a | 1, a ^ 1, a << 1, a >> 1, a >>> 1, a || b FROM t\",\n\"SELECT CASE a WHEN 1 THEN 'x' END, b ILIKE 'x' ESCAPE '/', b NOT RLIKE 'x', TRY_CAST(a AS INT) FROM t\",\n\"SELECT * FROM (t JOIN u ON true) x CROSS JOIN v LEFT SEMI JOIN w ON true\",\n\"TABLE t\", \"(SELECT a FROM t) ORDER BY a\", \"FROM t SELECT a UNION SELECT b\",\n\"WITH RECURSIVE c MAX RECURSION LEVEL 3 AS (SELECT a FROM t) SELECT a FROM c\",\n\"SELECT explode(a) AS (x, y) FROM t\",\n\"SELECT * FROM t JOIN LATERAL (SELECT a) s\",\n\"SELECT * FROM t WITH (k = true, n = 2) RIGHT JOIN (SELECT a FROM u) USING (a)\",\n\"SELECT -a, a % 2, a IS NULL, NULL FROM t ORDER BY a DESC NULLS FIRST, b NULLS LAST\",\n\"SELECT (t.a).b, ((a)).c.d FROM t\", \"SELECT 1BD, 1e3BD FROM t\",])"
---
SELECT 1
  => Project [1] | +- OneRowRelation | 
SELECT DISTINCT a FROM t
  => Distinct | +- Project [a] |    +- Read t | 
SELECT /*+ BROADCAST(t) */ a FROM t
  => Hint BROADCAST (t) | +- Project [a] |    +- Read t | 
SELECT a FROM t UNION SELECT a FROM u
  => Distinct | +- Union |    :- Project [a] |    :  +- Read t |    +- Project [a] |       +- Read u | 
VALUES (1)
  => InlineTable [col1] (1 rows) | 
SELECT * FROM VALUES (1) AS v(a)
  => Project [*] | +- SubqueryAlias v (a) |    +- InlineTable [a] (1 rows) | 
SELECT * FROM range(3)
  => [KRISHIV_UNSUPPORTED_FEATURE] The feature table-valued functions is not supported by Krishiv yet. SQLSTATE: 0A000 @ 14..22
SELECT a FROM t LATERAL VIEW explode(b) x AS y
  => [KRISHIV_UNSUPPORTED_FEATURE] The feature LATERAL VIEW is not supported by Krishiv yet. SQLSTATE: 0A000 @ 9..46
SELECT row_number() OVER (ORDER BY a) FROM t
  => Project [row_number() OVER (ORDER BY a ASC NULLS FIRST)] | +- Read t | 
SELECT a FROM t GROUP BY ROLLUP (a)
  => Aggregate [a] GROUPING SETS ((a), ()), [a] | +- Read t | 
SELECT a FROM t GROUP BY a WITH CUBE
  => Aggregate CUBE [a], [a] | +- Read t | 
SELECT * FROM t NATURAL JOIN u
  => Project [*] | +- Join Inner, NATURAL |    :- Read t |    +- Read u | 
SELECT * FROM t, LATERAL (SELECT a)
  => [KRISHIV_UNSUPPORTED_FEATURE] The feature LATERAL subqueries is not supported by Krishiv yet. SQLSTATE: 0A000 @ 17..35
SELECT * FROM t VERSION AS OF 1
  => [KRISHIV_UNSUPPORTED_FEATURE] The feature time travel is not supported by Krishiv yet. SQLSTATE: 0A000 @ 16..31
SELECT a FROM t CLUSTER BY a
  => [KRISHIV_UNSUPPORTED_FEATURE] The feature CLUSTER BY is not supported by Krishiv yet. SQLSTATE: 0A000 @ 0..28
SELECT a FROM t DISTRIBUTE BY a
  => [KRISHIV_UNSUPPORTED_FEATURE] The feature DISTRIBUTE BY is not supported by Krishiv yet. SQLSTATE: 0A000 @ 0..31
SELECT a FROM t LIMIT 1 OFFSET 2
  => Limit 1 | +- Offset 2 |    +- Project [a] |       +- Read t | 
FROM t SELECT a LIMIT 1 OFFSET 2
  => Limit 1 | +- Offset 2 |    +- Project [a] |       +- Read t | 
FROM t SELECT a CLUSTER BY a
  => [KRISHIV_UNSUPPORTED_FEATURE] The feature CLUSTER BY is not supported by Krishiv yet. SQLSTATE: 0A000 @ 7..28
FROM t SELECT a DISTRIBUTE BY a
  => [KRISHIV_UNSUPPORTED_FEATURE] The feature DISTRIBUTE BY is not supported by Krishiv yet. SQLSTATE: 0A000 @ 7..31
FROM t SELECT a WINDOW w AS (ORDER BY a)
  => Project [a] | +- Read t | 
SELECT a FROM t WINDOW w AS (ORDER BY a)
  => Project [a] | +- Read t | 
SELECT a FROM t QUALIFY a > 1
  => Filter qualify((a > 1)) | +- Project [a] |    +- Read t | 
WITH RECURSIVE r AS (SELECT a FROM t) SELECT * FROM r
  => [KRISHIV_UNSUPPORTED_FEATURE] The feature recursive CTEs is not supported by Krishiv yet. SQLSTATE: 0A000 @ 0..37
SELECT * EXCEPT (a) FROM t
  => Project [* EXCEPT (a)] | +- Read t | 
SELECT a FROM t INTERSECT SELECT a FROM u
  => Intersect false | :- Project [a] | :  +- Read t | +- Project [a] |    +- Read u | 
SELECT a FROM t EXCEPT ALL SELECT a FROM u
  => Except All true | :- Project [a] | :  +- Read t | +- Project [a] |    +- Read u | 
SELECT /*+ BROADCAST(t), MERGE(u) */ /*+ COALESCE(2) */ DISTINCT a FROM t, u
  => Hint BROADCAST (t) | +- Hint MERGE (u) |    +- Hint COALESCE (2) |       +- Distinct |          +- Project [a] |             +- Join Inner |                :- Read t |                +- Read u | 
SELECT a FROM t UNION ALL SELECT b FROM u UNION SELECT c FROM v
  => Distinct | +- Union |    :- Union |    :  :- Project [a] |    :  :  +- Read t |    :  +- Project [b] |    :     +- Read u |    +- Project [c] |       +- Read v | 
SELECT x[0] FROM t
  => [KRISHIV_UNSUPPORTED_FEATURE] The feature subscripts is not supported by Krishiv yet. SQLSTATE: 0A000 @ 7..11
SELECT (a).b.c FROM t
  => Project [a.b.c] | +- Read t | 
SELECT f(a).b FROM t
  => Project [f(a).b] | +- Read t | 
SELECT transform(a, x -> x) FROM t
  => Project [transform(a, (x) -> x)] | +- Read t | 
SELECT (a, b) FROM t
  => [KRISHIV_UNSUPPORTED_FEATURE] The feature row and struct constructors is not supported by Krishiv yet. SQLSTATE: 0A000 @ 7..13
SELECT a LIKE ANY ('x', 'y') FROM t
  => Project [a LIKE ANY ('x', 'y')] | +- Read t | 
SELECT ? FROM t
  => [KRISHIV_UNSUPPORTED_FEATURE] The feature parameter markers is not supported by Krishiv yet. SQLSTATE: 0A000 @ 7..8
SELECT INTERVAL 1 DAY FROM t
  => [KRISHIV_UNSUPPORTED_FEATURE] The feature INTERVAL literals is not supported by Krishiv yet. SQLSTATE: 0A000 @ 7..21
SELECT TIMESTAMP '2020-01-01 00:00:00' FROM t
  => Project [TIMESTAMP '2020-01-01 00:00:00'] | +- Read t | 
SELECT db.f(a) FROM t
  => Project [db.f(a)] | +- Read t | 
SELECT f(x => 1) FROM t
  => Project [f(x => 1)] | +- Read t | 
SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY a) FROM t
  => Project [percentile_cont(0.5) WITHIN GROUP (ORDER BY a)] | +- Read t | 
SELECT sum(a) IGNORE NULLS FROM t
  => [KRISHIV_UNSUPPORTED_FEATURE] The feature IGNORE NULLS and RESPECT NULLS is not supported by Krishiv yet. SQLSTATE: 0A000 @ 7..26
SELECT * FROM t WITH (k = x)
  => [PARSE_SYNTAX_ERROR] Syntax error at or near 'x'. SQLSTATE: 42601 @ 26..27
FROM t SELECT a SELECT b
  => [KRISHIV_UNSUPPORTED_FEATURE] The feature FROM with several SELECT bodies is not supported by Krishiv yet. SQLSTATE: 0A000 @ 0..24
SELECT * FROM parquet.`s3a://k:Canary-7f3a9c@b/p` WITH ('password' = 'Canary-7f3a9c')
  => Project [*] | +- Read parquet [s3a://k:*********(redacted)@b/p] {password=*********(redacted)} | 
WITH c (x) AS (SELECT a FROM t) SELECT x FROM c ORDER BY x LIMIT ALL
  => WithCte [c] | :- SubqueryAlias c (x) | :  +- Project [a] | :     +- Read t | +- Sort [x ASC NULLS FIRST], true |    +- Project [x] |       +- Read c | 
FROM t SELECT a SORT BY a
  => Sort [a ASC NULLS FIRST], false | +- Project [a] |    +- Read t | 
SELECT a FROM t WHERE (a, b) IN (SELECT a, d FROM u) AND a NOT BETWEEN 1 AND 2
  => Project [a] | +- Filter (((a, b) IN (list-query)) and (NOT (a BETWEEN 1 AND 2))) |    :  +- Project [a, d] |    :     +- Read u |    +- Read t | 
SELECT a <=> 1, a IS DISTINCT FROM 1, a IS NOT DISTINCT FROM 1, a IS TRUE, a IS NOT FALSE, a IS UNKNOWN, a IS NOT UNKNOWN FROM t
  => Project [(a <=> 1), (NOT (a <=> 1)), (a <=> 1), (a <=> true), (NOT (a <=> false)), isnull(a), isnotnull(a)] | +- Read t | 
SELECT +a, ~a, a DIV 2, a & 1, a | 1, a ^ 1, a << 1, a >> 1, a >>> 1, a || b FROM t
  => Project [positive(a), ~a, (a div 2), (a & 1), (a | 1), (a ^ 1), (a << 1), (a >> 1), (a >>> 1), concat(a, b)] | +- Read t | 
SELECT CASE a WHEN 1 THEN 'x' END, b ILIKE 'x' ESCAPE '/', b NOT RLIKE 'x', TRY_CAST(a AS INT) FROM t
  => Project [CASE WHEN (a == 1) THEN 'x' END, ilike(b, 'x', '/'), (NOT (b rlike 'x')), TRY_CAST(a AS INT)] | +- Read t | 
SELECT * FROM (t JOIN u ON true) x CROSS JOIN v LEFT SEMI JOIN w ON true
  => Project [*] | +- Join LeftSemi, true |    :- Join Cross |    :  :- SubqueryAlias x |    :  :  +- Join Inner, true |    :  :     :- Read t |    :  :     +- Read u |    :  +- Read v |    +- Read w | 
TABLE t
  => Read t | 
(SELECT a FROM t) ORDER BY a
  => Sort [a ASC NULLS FIRST], true | +- Project [a] |    +- Read t | 
FROM t SELECT a UNION SELECT b
  => Distinct | +- Union |    :- Project [a] |    :  +- Read t |    +- Project [b] |       +- OneRowRelation | 
WITH RECURSIVE c MAX RECURSION LEVEL 3 AS (SELECT a FROM t) SELECT a FROM c
  => [KRISHIV_UNSUPPORTED_FEATURE] The feature recursive CTEs is not supported by Krishiv yet. SQLSTATE: 0A000 @ 0..59
SELECT explode(a) AS (x, y) FROM t
  => [KRISHIV_UNSUPPORTED_FEATURE] The feature multi-name aliases is not supported by Krishiv yet. SQLSTATE: 0A000 @ 7..27
SELECT * FROM t JOIN LATERAL (SELECT a) s
  => [KRISHIV_UNSUPPORTED_FEATURE] The feature LATERAL joins is not supported by Krishiv yet. SQLSTATE: 0A000 @ 16..41
SELECT * FROM t WITH (k = true, n = 2) RIGHT JOIN (SELECT a FROM u) USING (a)
  => Project [*] | +- Join RightOuter, USING (a) |    :- Read t {k=true, n=2} |    +- SubqueryAlias __auto_generated_subquery_name |       +- Project [a] |          +- Read u | 
SELECT -a, a % 2, a IS NULL, NULL FROM t ORDER BY a DESC NULLS FIRST, b NULLS LAST
  => Sort [a DESC NULLS FIRST, b ASC NULLS LAST], true | +- Project [(- a), (a % 2), isnull(a), NULL] |    +- Read t | 
SELECT (t.a).b, ((a)).c.d FROM t
  => Project [t.a.b, a.c.d] | +- Read t | 
SELECT 1BD, 1e3BD FROM t
  => Project [1, 1000] | +- Read t |
