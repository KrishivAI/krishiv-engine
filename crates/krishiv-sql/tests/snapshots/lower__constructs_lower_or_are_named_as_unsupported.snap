WITH c (x) AS (SELECT a FROM t) SELECT x FROM c ORDER BY x LIMIT ALL
  => WithCte [c] | :- SubqueryAlias c (x) | :  +- Project [a] | :     +- Read t | +- Sort [x ASC NULLS FIRST], true |    +- Project [x] |       +- Read c | 
FROM t SELECT a SORT BY a
  => Sort [a ASC NULLS FIRST], false | +- Project [a] |    +- Read t | 
SELECT a FROM t WHERE (a, b) IN (SELECT a, d FROM u) AND a NOT BETWEEN 1 AND 2
  => Project [a] | +- Filter (((a, b) IN (list-query)) and (NOT (a BETWEEN 1 AND 2))) |    :  +- Project [a, d] |    :     +- Read u |    +- Read t | 
SELECT a <=> 1, a IS DISTINCT FROM 1, a IS NOT DISTINCT FROM 1, a IS TRUE, a IS NOT FALSE, a IS UNKNOWN, a IS NOT UNKNOWN FROM t
  => Project [(a <=> 1), (NOT (a <=> 1)), (a <=> 1), (a <=> true), (NOT (a <=> false)), isnull(a), isnotnull(a)] | +- Read t | 
SELECT +a, ~a, a DIV 2, a & 1, a | 1, a ^ 1, a << 1, a >> 1, a >>> 1, a || b FROM t
  => Project [positive(a), ~(a), (a div 2), &(a, 1), |(a, 1), ^(a, 1), shiftleft(a, 1), shiftright(a, 1), shiftrightunsigned(a, 1), concat(a, b)] | +- Read t | 
SELECT CASE a WHEN 1 THEN 'x' END, b ILIKE 'x' ESCAPE '/', b NOT RLIKE 'x', TRY_CAST(a AS INT) FROM t
  => Project [CASE WHEN (a == 1) THEN 'x' END, ilike(b, 'x', '/'), (NOT (b rlike 'x')), TRY_CAST(a AS INT)] | +- Read t | 
