---
source: crates/krishiv-sql/tests/lower.rs
expression: "report(&[\"FROM t |> WHERE a > 1 |> SELECT a, b |> ORDER BY a LIMIT 3\",\n\"SELECT * FROM t |> EXTEND a + 1 AS c |> DROP b |> AS u\",\n\"FROM t |> AGGREGATE sum(a) AS s GROUP BY b\",\n\"FROM t |> AGGREGATE GROUP BY b AS k\",\n\"FROM t |> JOIN u ON t.a = u.a |> UNION ALL (SELECT 1, 2)\",\n\"FROM t |> SELECT DISTINCT a\", \"FROM t |> AGGREGATE sum(a) GROUP BY 1\",\n\"FROM t |> SET a = 1\", \"FROM t |> TABLESAMPLE (3 ROWS)\",])"
---
FROM t |> WHERE a > 1 |> SELECT a, b |> ORDER BY a LIMIT 3
  => [MULTIPLE_QUERY_RESULT_CLAUSES_WITH_PIPE_OPERATORS] ORDER BY and LIMIT cannot coexist in the same SQL pipe operator using '|>'. Please separate the multiple result clauses into separate pipe operators and then retry the query again. SQLSTATE: 42000 @ 40..58
SELECT * FROM t |> EXTEND a + 1 AS c |> DROP b |> AS u
  => SubqueryAlias u | +- PipeOperator |    +- Project [* EXCEPT (b)] |       +- PipeOperator |          +- Project [*, (a + 1) AS c] |             +- PipeOperator |                +- Project [*] |                   +- Read t | 
FROM t |> AGGREGATE sum(a) AS s GROUP BY b
  => Aggregate [b], [b, sum(a) AS s] | +- PipeOperator |    +- Read t | 
FROM t |> AGGREGATE GROUP BY b AS k
  => Aggregate [b], [b AS k] | +- PipeOperator |    +- Read t | 
FROM t |> JOIN u ON t.a = u.a |> UNION ALL (SELECT 1, 2)
  => Union | :- PipeOperator | :  +- Join Inner, (t.a == u.a) | :     :- PipeOperator | :     :  +- Read t | :     +- Read u | +- Project [1, 2] |    +- OneRowRelation | 
FROM t |> SELECT DISTINCT a
  => Distinct | +- Project [a] |    +- PipeOperator |       +- Read t | 
FROM t |> AGGREGATE sum(a) GROUP BY 1
  => Aggregate [* @1], [* @1, sum(a)] | +- PipeOperator |    +- Read t | 
FROM t |> SET a = 1
  => Project [* REPLACE (a)] | +- PipeOperator |    +- Read t | 
FROM t |> TABLESAMPLE (3 ROWS)
  => [KRISHIV_UNSUPPORTED_FEATURE] The feature TABLESAMPLE is not supported by Krishiv yet. SQLSTATE: 0A000 @ 10..30
