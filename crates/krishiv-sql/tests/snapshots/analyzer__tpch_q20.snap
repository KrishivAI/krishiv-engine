---
source: crates/krishiv-sql/tests/analyzer.rs
expression: a.plan.root().to_string()
---
Sort [s_name#1 ASC NULLS FIRST], true
+- Project [s_name#1, s_address#2]
   +- Join LeftSemi, (s_suppkey#0 == ps_suppkey#12)
      :- Filter ((s_nationkey#3 == n_nationkey#7) and (n_name#8 == 'CANADA'))
      :  +- Join Inner
      :     :- Scan spark_catalog.default.supplier [s_suppkey#0, s_name#1, s_address#2, s_nationkey#3, s_phone#4, s_acctbal#5, s_comment#6]
      :     +- Scan spark_catalog.default.nation [n_nationkey#7, n_name#8, n_regionkey#9, n_comment#10]
      +- Project [ps_suppkey#12]
         +- Project [ps_partkey#11, ps_suppkey#12, ps_availqty#13, ps_supplycost#14, ps_comment#15]
            +- Filter (CAST(ps_availqty#13 AS DECIMAL(27,3)) > (0.5 * sum(l_quantity))#41)
               +- Join LeftOuter, ((ps_partkey#11 == l_partkey#26) and (ps_suppkey#12 == l_suppkey#27))
                  :- Join LeftSemi, (ps_partkey#11 == p_partkey#16)
                  :  :- Scan spark_catalog.default.partsupp [ps_partkey#11, ps_suppkey#12, ps_availqty#13, ps_supplycost#14, ps_comment#15]
                  :  +- Project [p_partkey#16]
                  :     +- Filter (p_name#17 like 'forest%')
                  :        +- Scan spark_catalog.default.part [p_partkey#16, p_name#17, p_mfgr#18, p_brand#19, p_type#20, p_size#21, p_container#22, p_retailprice#23, p_comment#24]
                  +- Aggregate [l_partkey#26, l_suppkey#27], [(0.5 * sum(l_quantity#29)) AS (0.5 * sum(l_quantity))#41, l_partkey#26, l_suppkey#27]
                     +- Filter ((l_shipdate#35 >= CAST('1994-01-01' AS DATE)) and (l_shipdate#35 < CAST('1995-01-01' AS DATE)))
                        +- Scan spark_catalog.default.lineitem [l_orderkey#25, l_partkey#26, l_suppkey#27, l_linenumber#28, l_quantity#29, l_extendedprice#30, l_discount#31, l_tax#32, l_returnflag#33, l_linestatus#34, l_shipdate#35, l_commitdate#36, l_receiptdate#37, l_shipinstruct#38, l_shipmode#39, l_comment#40]
