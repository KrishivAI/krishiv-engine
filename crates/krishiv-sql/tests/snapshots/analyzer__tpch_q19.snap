source: crates/krishiv-sql/tests/analyzer.rs
expression: a.plan.root().to_string()
---
Aggregate [], [sum((l_extendedprice#5 * (1 - l_discount#6))) AS revenue#25]
+- Filter ((((((p_partkey#16 == l_partkey#1) and (p_brand#19 == 'Brand#12')) and ((p_container#22 IN ('SM CASE', 'SM BOX', 'SM PACK', 'SM PKG')) and (l_quantity#4 >= 1))) and (((l_quantity#4 <= (1 + 10)) and (p_size#21 BETWEEN 1 AND 5)) and ((l_shipmode#14 IN ('AIR', 'AIR REG')) and (l_shipinstruct#13 == 'DELIVER IN PERSON')))) or ((((p_partkey#16 == l_partkey#1) and (p_brand#19 == 'Brand#23')) and ((p_container#22 IN ('MED BAG', 'MED BOX', 'MED PKG', 'MED PACK')) and (l_quantity#4 >= 10))) and (((l_quantity#4 <= (10 + 10)) and (p_size#21 BETWEEN 1 AND 10)) and ((l_shipmode#14 IN ('AIR', 'AIR REG')) and (l_shipinstruct#13 == 'DELIVER IN PERSON'))))) or ((((p_partkey#16 == l_partkey#1) and (p_brand#19 == 'Brand#34')) and ((p_container#22 IN ('LG CASE', 'LG BOX', 'LG PACK', 'LG PKG')) and (l_quantity#4 >= 20))) and (((l_quantity#4 <= (20 + 10)) and (p_size#21 BETWEEN 1 AND 15)) and ((l_shipmode#14 IN ('AIR', 'AIR REG')) and (l_shipinstruct#13 == 'DELIVER IN PERSON')))))
   +- Join Inner
      :- Scan spark_catalog.default.lineitem [l_orderkey#0, l_partkey#1, l_suppkey#2, l_linenumber#3, l_quantity#4, l_extendedprice#5, l_discount#6, l_tax#7, l_returnflag#8, l_linestatus#9, l_shipdate#10, l_commitdate#11, l_receiptdate#12, l_shipinstruct#13, l_shipmode#14, l_comment#15]
      +- Scan spark_catalog.default.part [p_partkey#16, p_name#17, p_mfgr#18, p_brand#19, p_type#20, p_size#21, p_container#22, p_retailprice#23, p_comment#24]
