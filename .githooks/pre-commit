#!/usr/bin/env sh
# SPDX-License-Identifier: Apache-2.0
# Krishiv pre-commit (ADR 0029): cargo fmt --check, the fast check that suits
# every commit. clippy and cargo-deny run once per push in pre-push, over all
# the commits being pushed.
# Enable once per clone:  git config core.hooksPath .githooks
set -eu

echo "pre-commit: cargo fmt --check"
cargo fmt --all -- --check
