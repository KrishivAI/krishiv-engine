#!/usr/bin/env sh
# SPDX-License-Identifier: Apache-2.0
# Krishiv commit-msg: refuses AI attribution (Co-Authored-By for an AI or bot,
# Claude-Session:, "Generated with", robot emoji). The same check runs in CI
# (.github/scripts/check-ai-attribution.sh). Then adds the DCO sign-off (ADR 0033)
# when the message has none, so a commit made without `-s` never fails the CI
# DCO check (and never needs a rewrite). Enabled by `cargo xtask setup`.
set -eu

root=$(git rev-parse --show-toplevel)
bash "$root/.github/scripts/check-ai-attribution.sh" --message-file "$1"

if ! grep -q '^Signed-off-by: .* <.*>$' "$1"; then
  # The committer's own identity, as `git commit -s` writes it.
  who=$(git var GIT_COMMITTER_IDENT | sed 's/ [0-9][0-9]* [-+][0-9]*$//')
  git interpret-trailers --in-place --trailer "Signed-off-by: $who" "$1"
fi
