#!/usr/bin/env sh
# SPDX-License-Identifier: Apache-2.0
# Krishiv pre-push (P2-T134): refuse pushes to main and non-fast-forward
# (force) pushes. Interim guard until branch protection is available on the
# org plan. Override deliberately with KRISHIV_ALLOW_MAIN_PUSH=1.
# Also runs the ruff version pinned in python/uv.lock (via uvx) on the Python
# files a push changes (format --check + check), as CI does; skipped with a
# message when uv is not installed (KRISHIV_UVX overrides the command).
# Install with `cargo xtask setup`.
set -eu

if [ "${KRISHIV_ALLOW_MAIN_PUSH:-0}" = "1" ]; then
  echo "pre-push: KRISHIV_ALLOW_MAIN_PUSH=1, guard bypassed" >&2
  exit 0
fi

zero=0000000000000000000000000000000000000000
status=0

# ruff_check <base> <local sha>: lint the .py files changed since <base>.
ruff_check() {
  files=$(git diff --name-only --diff-filter=d "$1" "$2" -- '*.py' 2>/dev/null || true)
  [ -n "$files" ] || return 0
  uvx_cmd="${KRISHIV_UVX:-uvx}"
  if ! command -v "$uvx_cmd" >/dev/null 2>&1; then
    echo "pre-push: uv is not installed, skipping the ruff check of changed Python files (CI still runs it)" >&2
    return 0
  fi
  lock="$(git rev-parse --show-toplevel)/python/uv.lock"
  version=$(awk '/^name = "ruff"$/ { f = 1; next } f && /^version = / { gsub(/[" ]|version=/, ""); print; exit }' "$lock" 2>/dev/null | sed 's/^version=//')
  if [ -z "$version" ]; then
    echo "pre-push: no ruff version in python/uv.lock, skipping the ruff check" >&2
    return 0
  fi
  # shellcheck disable=SC2086 # file names without spaces, one per line
  set -- $files
  if ! "$uvx_cmd" "ruff@$version" format --check "$@" || ! "$uvx_cmd" "ruff@$version" check "$@"; then
    echo "pre-push: ruff $version found problems in changed Python files (fix with: uvx ruff@$version format <files> && uvx ruff@$version check --fix <files>)" >&2
    return 1
  fi
}
# stdin: <local ref> <local sha> <remote ref> <remote sha> per ref being pushed.
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/master)
      echo "pre-push: refusing to push '$local_ref' to $remote_ref (set KRISHIV_ALLOW_MAIN_PUSH=1 to override)" >&2
      status=1
      continue
      ;;
  esac
  if [ "$local_sha" != "$zero" ]; then
    base="$remote_sha"
    if [ "$base" = "$zero" ]; then
      base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
    fi
    if [ -n "$base" ] && ! ruff_check "$base" "$local_sha"; then
      status=1
    fi
  fi
  # Branch deletion or creation cannot rewrite history.
  if [ "$local_sha" = "$zero" ] || [ "$remote_sha" = "$zero" ]; then
    continue
  fi
  case "$remote_ref" in
    refs/heads/*)
      # A remote commit we do not have, or one that is not an ancestor of what
      # we push, means this push rewrites remote history.
      if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo "pre-push: refusing non-fast-forward (force) push to $remote_ref (set KRISHIV_ALLOW_MAIN_PUSH=1 to override)" >&2
        status=1
      fi
      ;;
  esac
done
exit "$status"
